{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft-lab/racecraft-plugins-public/knowledge-update-plan.schema.json",
  "title": "SpecKit Pro OKF knowledge update plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "profile",
    "action",
    "scope",
    "request",
    "expected_snapshot",
    "resulting_snapshot",
    "operation_count",
    "operations",
    "source_preconditions",
    "warnings",
    "plan_hash"
  ],
  "properties": {
    "plan_version": { "const": "1.0" },
    "profile": { "const": "speckit-okf/1" },
    "action": {
      "enum": ["init", "migrate", "rebuild", "promote", "supersede", "archive"]
    },
    "scope": { "type": "string", "minLength": 1 },
    "request": { "$ref": "#/$defs/request" },
    "expected_snapshot": { "$ref": "#/$defs/snapshot" },
    "resulting_snapshot": { "$ref": "#/$defs/snapshot" },
    "operation_count": { "type": "integer", "minimum": 0 },
    "operations": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/operation" }
    },
    "source_preconditions": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/sourcePrecondition" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "plan_hash": { "$ref": "#/$defs/snapshot" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "request": {
      "oneOf": [
        { "$ref": "#/$defs/basicRequest" },
        { "$ref": "#/$defs/migrateRequest" },
        { "$ref": "#/$defs/promoteRequest" },
        { "$ref": "#/$defs/supersedeRequest" },
        { "$ref": "#/$defs/archiveRequest" }
      ]
    },
    "basicRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "timestamp"],
      "properties": {
        "action": { "enum": ["init", "rebuild"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "migrateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "timestamp", "legacy_memory_reviewed", "reviewed"],
      "properties": {
        "action": { "const": "migrate" },
        "timestamp": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "legacy_memory_reviewed": { "type": "boolean" },
        "reviewed": { "type": "boolean" }
      }
    },
    "promoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "timestamp", "candidate"],
      "properties": {
        "action": { "const": "promote" },
        "timestamp": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "candidate": { "$ref": "knowledge-candidate.schema.json" }
      }
    },
    "supersedeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "timestamp", "concept_path", "replacement"],
      "properties": {
        "action": { "const": "supersede" },
        "timestamp": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "concept_path": { "type": "string", "minLength": 1 },
        "replacement": { "$ref": "knowledge-candidate.schema.json" }
      }
    },
    "archiveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "timestamp", "concept_path"],
      "properties": {
        "action": { "const": "archive" },
        "timestamp": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "concept_path": { "type": "string", "minLength": 1 },
        "sources": { "$ref": "knowledge-candidate.schema.json#/properties/sources" }
      }
    },
    "sourcePrecondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "prior_sha256", "resulting_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "prior_sha256": { "$ref": "#/$defs/digest" },
        "resulting_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "target",
        "prior_sha256",
        "content_sha256",
        "content"
      ],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "kind": { "const": "write_file" },
        "target": { "type": "string", "minLength": 1 },
        "prior_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "content_sha256": { "$ref": "#/$defs/digest" },
        "content": { "type": "string" }
      }
    }
  }
}
