{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-control/v1",
  "title": "Durable execution accounting, not authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow_identity", "started_at", "slice_started_at", "last_observed_at", "checkpoint_at", "approved_invariants", "corrective_cycles", "reservations", "dispatches", "excluded_intervals", "active_wait", "authorization_granted"],
  "properties": {
    "schema_version": {"const": "execution-control/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_identity": {"type": "object", "additionalProperties": false, "required": ["original_workflow_file", "current_workflow_file", "relocation_event_ids"], "properties": {"original_workflow_file": {"type": "string", "minLength": 1}, "current_workflow_file": {"type": "string", "minLength": 1}, "relocation_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "started_at": {"type": "number", "minimum": 0},
    "slice_started_at": {"type": "number", "minimum": 0},
    "last_observed_at": {"type": "number", "minimum": 0},
    "checkpoint_at": {"type": "number", "minimum": 0},
    "approved_invariants": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "invariant_binding": {"type": "object", "additionalProperties": false, "required": ["spec_file", "spec_sha256", "bound_at"], "properties": {"spec_file": {"type": "string", "minLength": 1}, "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bound_at": {"type": "number", "minimum": 0}, "planning_fingerprints": {"type": "object", "additionalProperties": false, "required": ["spec_sha256", "plan_sha256", "tasks_sha256"], "properties": {"spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "tasks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
    "corrective_cycles": {"type": "integer", "minimum": 0, "maximum": 2},
    "corrective_exception": {"type": "object", "additionalProperties": false, "required": ["reservation_id", "dispatch_id", "failure_invariant", "refusal_reason", "scope_sha256", "spec_sha256", "operator_exception_event_id", "authorized_at"], "properties": {"reservation_id": {"type": "string", "minLength": 1}, "dispatch_id": {"type": "string", "minLength": 1}, "failure_invariant": {"type": "string", "minLength": 1}, "refusal_reason": {"enum": ["failure_family_budget_exhausted", "corrective_run_budget_exhausted"]}, "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "operator_exception_event_id": {"type": "string", "minLength": 1}, "authorized_at": {"type": "number", "minimum": 0}, "failure_class": {"type": "object", "additionalProperties": false, "required": ["test_file", "failure_signature", "change_kind", "follow_up_dispatch_ids"], "properties": {"test_file": {"type": "string", "minLength": 1}, "failure_signature": {"type": "string", "minLength": 1, "maxLength": 240}, "change_kind": {"enum": ["test_timeout"]}, "follow_up_dispatch_ids": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}},
    "reservations": {"type": "object", "maxProperties": 2, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["family", "dispatch_id", "reserved_at"], "properties": {"family": {"type": "string"}, "dispatch_id": {"type": "string"}, "reserved_at": {"type": "number", "minimum": 0}}}},
    "dispatches": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["kind", "outcome", "reserved_at", "reservation_id", "reconciliations"], "properties": {"kind": {"enum": ["implementation", "corrective", "verification", "infrastructure"]}, "outcome": {"enum": ["reserved", "running", "completed", "failed", "unknown", "expected_tdd_red"]}, "reserved_at": {"type": "number", "minimum": 0}, "completed_at": {"type": "number", "minimum": 0}, "reservation_id": {"type": ["string", "null"]}, "resolution_event_id": {"type": "string", "minLength": 1}, "recovery_of": {"type": "string", "minLength": 1}, "failure_event_id": {"type": "string", "minLength": 1}, "operator_recovery_event_id": {"type": "string", "minLength": 1}, "continuation_of": {"type": "string", "minLength": 1}, "operator_continuation_event_id": {"type": "string", "minLength": 1}, "continuation_purpose": {"const": "task_metadata_reconciliation"}, "increment": {"type": "string", "minLength": 1}, "gate": {"enum": ["G2", "G3", "G4", "G5", "G6", "G7"]}, "metadata_correction": {"$ref": "#/properties/metadata_corrections/items/properties/task_ids"}, "tdd_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}, "test_fix": {"type": "string", "minLength": 1}, "escalation": {"type": "string", "minLength": 1}, "escalation_tier": {"enum": [2, 3]}, "test_fix_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "worktree_before": {"type": "object", "additionalProperties": false, "required": ["head", "dirty"], "properties": {"head": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, "dirty": {"type": "object", "additionalProperties": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}}, "reconciliation": {"type": "object", "additionalProperties": false, "required": ["class", "paths", "at"], "properties": {"class": {"enum": ["partial", "complete"]}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "at": {"type": "number", "minimum": 0}}}, "reconciled_as": {"const": "no_effect"}, "verifies": {"type": "string", "minLength": 1}, "verified_by": {"type": "string", "minLength": 1}, "reconciliations": {"type": "integer", "minimum": 0, "maximum": 1}, "baseline": {"type": "string", "minLength": 1}, "progress_of": {"type": "string", "minLength": 1}, "spec_file": {"type": "string", "minLength": 1}, "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "failing_checks": {"type": "object", "additionalProperties": false, "required": ["command_id", "command_sha256", "format", "failing", "passing", "checks_run", "output_sha256", "recorded_at"], "properties": {"command_id": {"type": "string", "minLength": 1, "maxLength": 240}, "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "checks_run": {"type": ["integer", "null"], "minimum": 0}, "format": {"enum": ["unittest", "pytest", "bun", "jest", "go", "cargo", "vitest", "mocha", "junit", "passed", "unparsed"]}, "failing": {"type": ["array", "null"], "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}, "passing": {"type": ["array", "null"], "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}, "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recorded_at": {"type": "number", "minimum": 0}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "worktree_clean": {"type": "boolean"}}, "dependentRequired": {"head_sha": ["worktree_clean"], "worktree_clean": ["head_sha"]}}}}},
    "increment_allowances": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["rounds", "dispatch_ids"], "properties": {"rounds": {"type": "integer", "minimum": 1, "maximum": 2}, "dispatch_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "escalation_allowances": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["unit_kind", "unit", "tier", "dispatches"], "properties": {"unit_kind": {"enum": ["failure_family", "increment", "gate", "failure_class", "gate_failure"]}, "unit": {"type": "string", "minLength": 1}, "tier": {"enum": [2, 3]}, "dispatches": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["tier", "dispatch_id", "reserved_at"], "properties": {"tier": {"enum": [2, 3]}, "dispatch_id": {"type": "string", "minLength": 1}, "reserved_at": {"type": "number", "minimum": 0}}}}}}},
    "escalation_tier3_cap": {"const": 3},
    "finalize_observations": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 3}},
    "test_fix_allowances": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["rounds", "dispatch_ids"], "properties": {"rounds": {"type": "integer", "minimum": 1, "maximum": 1}, "dispatch_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "gate_allowances": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["G2", "G3", "G4", "G5", "G6", "G7"]}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["rounds", "dispatch_ids"], "properties": {"rounds": {"type": "integer", "minimum": 1, "maximum": 2}, "dispatch_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "deferred": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dispatch_id", "reason", "unit_kind", "unit", "deferred_at"], "properties": {"dispatch_id": {"type": "string", "minLength": 1}, "reason": {"enum": ["failure_family_budget_exhausted", "corrective_run_budget_exhausted", "corrective_cycle_failed_no_nested_retry", "corrective_cycle_already_closed", "increment_review_allowance_exhausted", "gate_remediation_allowance_exhausted", "failure_class_allowance_exhausted"]}, "unit_kind": {"enum": ["failure_family", "increment", "gate", "failure_class"]}, "unit": {"type": "string", "minLength": 1, "maxLength": 240}, "deferred_at": {"type": "number", "minimum": 0}, "resolved_by": {"type": "string", "minLength": 1}, "resolved_at": {"type": "number", "minimum": 0}}, "dependentRequired": {"resolved_by": ["resolved_at"], "resolved_at": ["resolved_by"]}}},
    "metadata_corrections": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dispatch_id", "task_ids", "tasks_file", "baseline_sha256", "corrected_sha256", "admitted_at"], "properties": {"dispatch_id": {"type": "string", "minLength": 1}, "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}}, "tasks_file": {"type": "string", "minLength": 1}, "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "corrected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "admitted_at": {"type": "number", "minimum": 0}}}},
    "corrective_epochs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["epoch_event_id", "closed_at", "corrective_cycles", "reservations", "dispatches", "approved_invariants"], "properties": {"epoch_event_id": {"type": "string", "minLength": 1}, "closed_at": {"type": "number", "minimum": 0}, "corrective_cycles": {"$ref": "#/properties/corrective_cycles"}, "reservations": {"$ref": "#/properties/reservations"}, "dispatches": {"$ref": "#/properties/dispatches"}, "approved_invariants": {"$ref": "#/properties/approved_invariants"}, "invariant_binding": {"$ref": "#/properties/invariant_binding"}, "corrective_exception": {"$ref": "#/properties/corrective_exception"}, "increment_allowances": {"$ref": "#/properties/increment_allowances"}, "test_fix_allowances": {"$ref": "#/properties/test_fix_allowances"}, "escalation_allowances": {"$ref": "#/properties/escalation_allowances"}, "gate_allowances": {"$ref": "#/properties/gate_allowances"}, "deferred": {"$ref": "#/properties/deferred"}, "metadata_corrections": {"$ref": "#/properties/metadata_corrections"}, "stage_transition": {"enum": ["implement"]}}}},
    "excluded_intervals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "kind", "start_event", "end_event"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}, "kind": {"enum": ["human_uat", "external_approval"]}, "start_event": {"type": "string", "minLength": 1}, "end_event": {"type": "string", "minLength": 1}}}},
    "active_wait": {"type": ["object", "null"], "required": ["start", "kind", "start_event"], "additionalProperties": false, "properties": {"start": {"type": "number", "minimum": 0}, "kind": {"enum": ["human_uat", "external_approval"]}, "start_event": {"type": "string", "minLength": 1}}},
    "authorization_granted": {"const": false}
  }
}
