      "language": "typescript",
      "slot": "DEPENDENCY_RULES",
      "signal": { "kind": "file", "path": ".dependency-cruiser.cjs" },
      "tool": "dependency-cruiser",
      "install": "pnpm add -D dependency-cruiser",
      "command": "pnpm exec depcruise --config {rules_path} --output-type err {paths}"
    }
  ]
