{
  "mcpServers": {
    "jev": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/evaluate_launch.py"
      ],
      "env": {
        "JEV_PROVIDER": "typesafe",
        "JEV_MODEL": "jev-latest",
        "JEV_FALLBACK_PROVIDER": "openrouter",
        "JEV_REQUEST_TIMEOUT": "45s"
      },
      "timeout": 75000
    }
  }
}
