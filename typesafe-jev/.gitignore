.DS_Store
/evaluate
.env
.task/

# Racecraft fork: local evidence, builds, and credentials.
.artifacts/
# bin/* not bin/: git cannot re-include a file whose parent dir is excluded.
bin/*
!bin/evaluate-launch
*.key
*.bak
.env.*

# Local developer environment (direnv). Committing it is the operator's call.
.envrc

# Eval run output is machine-specific and can be large.
evals/results/
