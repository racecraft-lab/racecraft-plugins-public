{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/racecraft-lab/racecraft-plugins-public/blob/main/docs/ai/research/agent-route-candidate-manifest.schema.json",
  "title": "Agent Route Candidate Manifest",
  "description": "Shared CAR-001 and G56R-001 evidence and candidate-route contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_kind",
    "platform",
    "spec_id",
    "provisional",
    "snapshot",
    "evidence_authority",
    "immutable_production_comparator",
    "official_source_ledger",
    "effort_surface_records",
    "project_inputs",
    "agent_contracts",
    "candidate_routes",
    "fixture_backlog",
    "telemetry_requirements",
    "capability_questions",
    "traceability",
    "decisions",
    "invalidation_rules"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "2.0.0"},
    "manifest_kind": {"const": "agent_route_candidate_manifest"},
    "platform": {"enum": ["claude_code", "codex"]},
    "spec_id": {"enum": ["CAR-001", "G56R-001"]},
    "provisional": {"const": true},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "evidence_authority": {"$ref": "#/$defs/evidenceAuthority"},
    "immutable_production_comparator": {"$ref": "#/$defs/comparator"},
    "official_source_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/officialSource"}},
    "effort_surface_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effortSurface"}},
    "project_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/projectInput"}},
    "agent_contracts": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/agentContract"}},
    "candidate_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateRoute"}},
    "fixture_backlog": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/fixture"}},
    "telemetry_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/telemetry"}},
    "capability_questions": {"type": "array", "items": {"$ref": "#/$defs/capabilityQuestion"}},
    "traceability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/traceability"}},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "invalidation_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invalidationRule"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "captured_at_utc", "prior_snapshot_id", "supersedes_manifest_version", "historical_artifact_refs", "change_summary", "legacy_fact_dispositions", "refresh_required_before"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "captured_at_utc": {"type": "string", "format": "date-time"},
        "prior_snapshot_id": {"$ref": "#/$defs/nullableString"},
        "supersedes_manifest_version": {"$ref": "#/$defs/nullableString"},
        "historical_artifact_refs": {"$ref": "#/$defs/stringArray"},
        "change_summary": {"type": "string", "minLength": 1},
        "legacy_fact_dispositions": {"type": "array", "items": {"$ref": "#/$defs/factDisposition"}},
        "refresh_required_before": {"type": "array", "items": {"enum": ["next_consuming_scaffold", "release"]}, "minItems": 2, "maxItems": 2, "uniqueItems": true}
      }
    },
    "factDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_fact_id", "disposition", "replacement_claim_id", "official_source_ledger_ids", "note"],
      "properties": {
        "legacy_fact_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["confirmed_current", "changed", "superseded", "withdrawn", "conflicting", "undocumented"]},
        "replacement_claim_id": {"$ref": "#/$defs/nullableString"},
        "official_source_ledger_ids": {"$ref": "#/$defs/stringArray"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "evidenceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "authoritative_domains", "evidence_classes", "platform_fact_rule", "candidate_admission_rule", "cross_platform_rule", "fail_closed_rule"],
      "properties": {
        "vendor": {"enum": ["anthropic", "openai"]},
        "authoritative_domains": {"$ref": "#/$defs/stringArray"},
        "evidence_classes": {"type": "array", "items": {"enum": ["official_documentation", "project_input", "runtime_verification_needed", "qualification_needed", "undocumented"]}, "minItems": 5, "maxItems": 5, "uniqueItems": true},
        "platform_fact_rule": {"type": "string", "minLength": 1},
        "candidate_admission_rule": {"type": "string", "minLength": 1},
        "cross_platform_rule": {"type": "string", "minLength": 1},
        "fail_closed_rule": {"type": "string", "minLength": 1}
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_tag", "commit_sha", "pin_rationale", "reconciliation_note", "source_agent_roots"],
      "properties": {
        "release_tag": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pin_rationale": {"type": "string", "minLength": 1},
        "reconciliation_note": {"type": "string", "minLength": 1},
        "source_agent_roots": {"$ref": "#/$defs/stringArray"}
      }
    },
    "boundedExtract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "extract_sha256", "normalization"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 700},
        "extract_sha256": {"$ref": "#/$defs/sha256"},
        "normalization": {"const": "unicode_text_whitespace_collapsed_utf8"}
      }
    },
    "officialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_source_ledger_id", "vendor", "source_family", "document_class", "requested_url", "canonical_url", "retrieved_at_utc", "http_status", "body_bytes", "body_sha256", "page_or_surface", "locator", "supported_surfaces", "exact_documented_facts", "bounded_extracts", "claim_bindings", "access_status", "conflict_status", "gaps", "invalidation_triggers"],
      "properties": {
        "official_source_ledger_id": {"type": "string", "minLength": 1},
        "vendor": {"enum": ["anthropic", "openai"]},
        "source_family": {"type": "string", "minLength": 1},
        "document_class": {"enum": ["coding_agent_documentation", "platform_api_documentation", "api_reference", "documentation_index"]},
        "requested_url": {"type": "string", "format": "uri"},
        "canonical_url": {"type": "string", "format": "uri"},
        "retrieved_at_utc": {"type": "string", "format": "date-time"},
        "http_status": {"type": "integer", "minimum": 200, "maximum": 399},
        "body_bytes": {"type": "integer", "minimum": 1},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "page_or_surface": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "supported_surfaces": {"$ref": "#/$defs/stringArray"},
        "exact_documented_facts": {"$ref": "#/$defs/stringArray"},
        "bounded_extracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundedExtract"}},
        "claim_bindings": {"$ref": "#/$defs/stringArray"},
        "access_status": {"enum": ["accessible", "redirected", "inaccessible"]},
        "conflict_status": {"enum": ["none", "scoped_difference", "conflicting"]},
        "gaps": {"$ref": "#/$defs/stringArray"},
        "invalidation_triggers": {"$ref": "#/$defs/stringArray"}
      }
    },
    "effortSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effort_surface_record_id", "official_source_ledger_id", "surface", "field", "documented_values", "default_value", "scope", "support_status", "runtime_verification_needed", "notes"],
      "properties": {
        "effort_surface_record_id": {"type": "string", "minLength": 1},
        "official_source_ledger_id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "documented_values": {"$ref": "#/$defs/stringArray"},
        "default_value": {"$ref": "#/$defs/nullableString"},
        "scope": {"type": "string", "minLength": 1},
        "support_status": {"enum": ["documented", "partially_documented", "not_documented", "not_applicable"]},
        "runtime_verification_needed": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "projectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_input_id", "kind", "ref", "status", "sha256", "claim_bindings", "notes"],
      "properties": {
        "project_input_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["repository_file", "release", "roadmap", "prd", "historical_snapshot"]},
        "ref": {"type": "string", "minLength": 1},
        "status": {"enum": ["present", "recorded_absence", "historical"]},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "claim_bindings": {"$ref": "#/$defs/stringArray"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "productionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model_selector", "effort_selector"],
      "properties": {
        "status": {"enum": ["present", "recorded_absence"]},
        "model_selector": {"$ref": "#/$defs/nullableString"},
        "effort_selector": {"$ref": "#/$defs/nullableString"}
      }
    },
    "agentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_contract_id", "agent_name", "role_summary", "safety_boundary", "grounding_contract", "mutation_boundary", "tool_contract", "skill_contract", "mcp_contract", "output_contract", "required_capabilities", "source_ref", "source_sha256", "instruction_sha256", "production_route", "platform_field_mappings", "platform_divergences", "fixture_backlog_ids", "notes", "invalidation_triggers"],
      "properties": {
        "agent_contract_id": {"type": "string", "minLength": 1},
        "agent_name": {"type": "string", "minLength": 1},
        "role_summary": {"type": "string", "minLength": 1},
        "safety_boundary": {"type": "string", "minLength": 1},
        "grounding_contract": {"type": "string", "minLength": 1},
        "mutation_boundary": {"type": "string", "minLength": 1},
        "tool_contract": {"$ref": "#/$defs/stringArray"},
        "skill_contract": {"$ref": "#/$defs/stringArray"},
        "mcp_contract": {"$ref": "#/$defs/stringArray"},
        "output_contract": {"type": "string", "minLength": 1},
        "required_capabilities": {"$ref": "#/$defs/stringArray"},
        "source_ref": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "instruction_sha256": {"$ref": "#/$defs/sha256"},
        "production_route": {"$ref": "#/$defs/productionRoute"},
        "platform_field_mappings": {"type": "object"},
        "platform_divergences": {"$ref": "#/$defs/stringArray"},
        "fixture_backlog_ids": {"$ref": "#/$defs/stringArray"},
        "notes": {"$ref": "#/$defs/stringArray"},
        "invalidation_triggers": {"$ref": "#/$defs/stringArray"}
      }
    },
    "modelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested_value", "expected_resolved_model_id"],
      "properties": {
        "kind": {"enum": ["alias", "model_id", "inherited", "undocumented"]},
        "requested_value": {"type": "string", "minLength": 1},
        "expected_resolved_model_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "effortSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "requested_value", "support_status"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "requested_value": {"$ref": "#/$defs/nullableString"},
        "support_status": {"enum": ["documented", "runtime_verification_needed", "undocumented", "not_applicable"]}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "shutdown_date", "replacement_model", "official_source_ledger_id"],
      "properties": {
        "status": {"enum": ["active", "deprecated", "retiring", "retired", "unknown"]},
        "shutdown_date": {"$ref": "#/$defs/nullableString"},
        "replacement_model": {"$ref": "#/$defs/nullableString"},
        "official_source_ledger_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "candidateRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_route_id", "agent_contract_id", "model_selector", "effort_selector", "official_source_ledger_ids", "effort_surface_record_ids", "candidate_status", "eligibility_basis", "executability_status", "required_capabilities", "known_gaps", "incompatibilities", "lifecycle", "qualification_artifact_refs", "capability_question_refs", "role_instruction_sha256", "invalidation_triggers"],
      "properties": {
        "candidate_route_id": {"type": "string", "minLength": 1},
        "agent_contract_id": {"type": "string", "minLength": 1},
        "model_selector": {"$ref": "#/$defs/modelSelector"},
        "effort_selector": {"$ref": "#/$defs/effortSelector"},
        "official_source_ledger_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "effort_surface_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "candidate_status": {"enum": ["source_bound_provisional", "blocked_undocumented", "excluded"]},
        "eligibility_basis": {"type": "string", "minLength": 1},
        "executability_status": {"const": "not_executable_pending_capability_and_qualification"},
        "required_capabilities": {"$ref": "#/$defs/stringArray"},
        "known_gaps": {"$ref": "#/$defs/stringArray"},
        "incompatibilities": {"$ref": "#/$defs/stringArray"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "qualification_artifact_refs": {"$ref": "#/$defs/stringArray"},
        "capability_question_refs": {"$ref": "#/$defs/stringArray"},
        "role_instruction_sha256": {"$ref": "#/$defs/sha256"},
        "invalidation_triggers": {"$ref": "#/$defs/stringArray"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_backlog_id", "agent_contract_id", "representative_tasks", "required_evidence", "pass_fail_signal", "status"],
      "properties": {
        "fixture_backlog_id": {"type": "string", "minLength": 1},
        "agent_contract_id": {"type": "string", "minLength": 1},
        "representative_tasks": {"$ref": "#/$defs/stringArray"},
        "required_evidence": {"$ref": "#/$defs/stringArray"},
        "pass_fail_signal": {"type": "string", "minLength": 1},
        "status": {"const": "deferred_to_qualification"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telemetry_requirement_id", "field", "source_class", "official_source_ledger_id", "surface", "necessity", "availability", "evidence_rule"],
      "properties": {
        "telemetry_requirement_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "source_class": {"enum": ["official_documentation", "derived_from_controlled_configuration", "runtime_verification_needed", "undocumented"]},
        "official_source_ledger_id": {"$ref": "#/$defs/nullableString"},
        "surface": {"type": "string", "minLength": 1},
        "necessity": {"enum": ["mandatory", "conditional", "diagnostic_only", "unavailable"]},
        "availability": {"enum": ["documented", "conditional", "derived", "undocumented", "not_applicable"]},
        "evidence_rule": {"type": "string", "minLength": 1}
      }
    },
    "capabilityQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_question_id", "question", "blocks", "source_gap", "status"],
      "properties": {
        "capability_question_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "blocks": {"$ref": "#/$defs/stringArray"},
        "source_gap": {"type": "string", "minLength": 1},
        "status": {"const": "open"}
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "artifact_refs", "claim_ids", "official_source_ledger_ids", "status"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "artifact_refs": {"$ref": "#/$defs/stringArray"},
        "claim_ids": {"$ref": "#/$defs/stringArray"},
        "official_source_ledger_ids": {"$ref": "#/$defs/stringArray"},
        "status": {"enum": ["verified", "blocked", "not_applicable"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "date", "title", "decision", "rationale", "supersedes"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "title": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "supersedes": {"$ref": "#/$defs/stringArray"}
      }
    },
    "invalidationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidation_rule_id", "trigger", "affected_ids", "action"],
      "properties": {
        "invalidation_rule_id": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "affected_ids": {"$ref": "#/$defs/stringArray"},
        "action": {"type": "string", "minLength": 1}
      }
    }
  }
}
