{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-record/v1",
  "title": "Verification record requiring independent native provenance and qualified isolation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "dispatch_id", "command_id", "argv", "workflow_file", "snapshot_sha256", "environment_sha256", "output_directory", "toolchain", "exit_code", "stdout_sha256", "stderr_sha256", "inputs_unchanged", "snapshot_unchanged", "producer", "completed", "elapsed_seconds", "isolation_mode"],
  "properties": {
    "schema_version": {"const": "verification-record/v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "command_id": {"enum": ["BUILD", "TYPECHECK", "LINT", "UNIT_TEST", "INTEGRATION_TEST", "FULL_VERIFY", "COMPLEXITY", "MUTATION", "DEPENDENCY_RULES"]},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "workflow_file": {"type": "string", "minLength": 1},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_directory": {"type": "string", "minLength": 1},
    "toolchain": {"type": "object", "required": ["executable", "executable_sha256", "runner_sha256"], "additionalProperties": false, "properties": {"executable": {"type": "string"}, "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "exit_code": {"type": ["integer", "null"]},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs_unchanged": {"type": "boolean"},
    "snapshot_unchanged": {"type": "boolean"},
    "producer": {"const": "runner-isolated-project-command/v1"},
    "completed": {"type": "boolean"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "isolation_mode": {"enum": ["copy_only", "qualified_readonly_snapshot"]}
  }
}
