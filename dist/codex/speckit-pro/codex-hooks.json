{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": []
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/workflow-guard-hook.py lockfile workflow-guard-v1",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/codex-agent-policy-hook.py agent-policy-v1",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/workflow-guard-hook.py unpushed workflow-guard-v1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
