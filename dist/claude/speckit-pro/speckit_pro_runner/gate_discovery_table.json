{
  "schema_version": "1.0",
  "rows": [
    {
      "language": "python",
      "slot": "COMPLEXITY",
      "signal": { "kind": "file", "path": "pyproject.toml" },
      "tool": "radon + coverage.py (CRAP join)",
      "install": "pipx install radon; add coverage to this project's dev dependencies (for example uv add --dev coverage), because coverage run -m pytest must use pytest's interpreter",
      "probe": ["radon", "coverage"],
      "command": "coverage run -m pytest -q && python3 {plugin_root}/scripts/crap-score.py --language python --ceiling {ceiling} --complexity-ceiling {complexity_ceiling} -- {paths}"
    },
    {
      "language": "python",
      "slot": "MUTATION",
      "signal": { "kind": "file", "path": "cosmic-ray.toml" },
      "tool": "cosmic-ray",
      "install": "pipx install cosmic-ray",
      "probe": ["cosmic-ray", "cr-filter-git", "cr-rate"],
      "command": "cosmic-ray init cosmic-ray.toml .cosmic-ray.sqlite --force && printf '[cosmic-ray.filters.git-filter]\\nbranch = \"%s\"\\n' '{base_branch}' | cr-filter-git --config - .cosmic-ray.sqlite && cosmic-ray baseline cosmic-ray.toml && cosmic-ray exec cosmic-ray.toml .cosmic-ray.sqlite && cr-rate .cosmic-ray.sqlite --fail-over {survival_ceiling}"
    },
    {
      "language": "python",
      "slot": "DEPENDENCY_RULES",
      "signal": { "kind": "file", "path": ".importlinter" },
      "tool": "import-linter",
      "install": "pipx install import-linter",
      "probe": ["lint-imports"],
      "command": "lint-imports --config {rules_path}"
    },
    {
      "language": "python",
      "slot": "DEPENDENCY_RULES",
      "signal": { "kind": "file", "path": "pyproject.toml" },
      "tool": "import-linter",
      "install": "pipx install import-linter",
      "probe": ["lint-imports"],
      "command": "lint-imports --config {rules_path}"
    },
    {
      "language": "typescript",
      "slot": "COMPLEXITY",
      "signal": { "kind": "file", "path": "bun.lock" },
      "tool": "oxlint complexity + Bun lcov coverage (CRAP join)",
      "install": "bun add -d oxlint",
      "probe": ["oxlint"],
      "command": "bun test --isolate --coverage --coverage-reporter=lcov && python3 {plugin_root}/scripts/crap-score.py --language typescript --complexity-tool oxlint --coverage-lcov coverage/lcov.info --ceiling {ceiling} --complexity-ceiling {complexity_ceiling} -- {paths}"
    },
    {
      "language": "typescript",
      "slot": "MUTATION",
      "signal": { "kind": "file", "path": "bun.lock" },
      "tool": "StrykerJS + Bun test runner",
      "install": "bun add -d @stryker-mutator/core @hughescr/stryker-bun-runner",
      "probe": ["stryker"],
      "command": "bunx stryker run --testRunner bun --appendPlugins @hughescr/stryker-bun-runner --reporters json,progress --incremental --mutate {paths_csv} && python3 {plugin_root}/scripts/mutation-score.py --report reports/mutation/mutation.json --floor {floor}"
    },
    {
      "language": "typescript",
      "slot": "COMPLEXITY",
      "signal": { "kind": "file", "path": "vitest.config.ts" },
      "tool": "ESLint complexity + Vitest coverage (CRAP join)",
      "install": "pnpm add -D eslint typescript-eslint @vitest/coverage-v8",
      "probe": ["eslint"],
      "command": "pnpm exec vitest run --coverage --coverage.reporter=json && python3 {plugin_root}/scripts/crap-score.py --language typescript --ceiling {ceiling} --complexity-ceiling {complexity_ceiling} -- {paths}"
    },
    {
      "language": "typescript",
      "slot": "COMPLEXITY",
      "signal": { "kind": "file", "path": "jest.config.js" },
      "tool": "ESLint complexity + Jest coverage (CRAP join)",
      "install": "pnpm add -D eslint typescript-eslint jest",
      "probe": ["eslint"],
      "command": "pnpm exec jest --coverage --coverageReporters=json && python3 {plugin_root}/scripts/crap-score.py --language typescript --ceiling {ceiling} --complexity-ceiling {complexity_ceiling} -- {paths}"
    },
    {
      "language": "typescript",
      "slot": "COMPLEXITY",
      "signal": { "kind": "file", "path": "package.json" },
      "tool": "ESLint complexity + c8 coverage (CRAP join)",
      "install": "pnpm add -D eslint typescript-eslint c8",
      "probe": ["eslint"],
      "command": "pnpm exec c8 --reporter=json pnpm test && python3 {plugin_root}/scripts/crap-score.py --language typescript --ceiling {ceiling} --complexity-ceiling {complexity_ceiling} -- {paths}"
    },
    {
      "language": "typescript",
      "slot": "MUTATION",
      "signal": { "kind": "file", "path": "stryker.config.json" },
      "tool": "StrykerJS",
      "install": "pnpm add -D @stryker-mutator/core",
      "probe": ["stryker"],
      "command": "pnpm exec stryker run --reporters json,progress --incremental --mutate {paths_csv} && python3 {plugin_root}/scripts/mutation-score.py --report reports/mutation/mutation.json --floor {floor}"
    },
    {
      "language": "typescript",
      "slot": "DEPENDENCY_RULES",
      "signal": { "kind": "file", "path": ".dependency-cruiser.cjs" },
      "tool": "dependency-cruiser",
      "install": "pnpm add -D dependency-cruiser",
      "probe": ["depcruise"],
      "command": "pnpm exec depcruise --config {rules_path} --output-type err {paths}"
    },
    {
      "language": "python",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "requirements.txt" },
      "tool": "pip-audit",
      "install": "pipx install pip-audit",
      "probe": ["pip-audit"],
      "command": "pip-audit -r requirements.txt --disable-pip --no-deps"
    },
    {
      "language": "python",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "pylock.toml" },
      "tool": "pip-audit",
      "install": "pipx install pip-audit",
      "probe": ["pip-audit"],
      "command": "pip-audit --locked ."
    },
    {
      "language": "typescript",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "bun.lock" },
      "tool": "bun audit",
      "install": "npm install -g bun",
      "probe": ["bun"],
      "command": "env -i PATH=\"$PATH\" HOME=\"$HOME\" npm_config_userconfig=/dev/null bun audit --audit-level=high --registry=https://registry.npmjs.org/"
    },
    {
      "language": "typescript",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "pnpm-lock.yaml" },
      "tool": "pnpm audit",
      "install": "corepack enable pnpm",
      "probe": ["pnpm"],
      "command": "env -i PATH=\"$PATH\" HOME=\"$HOME\" npm_config_userconfig=/dev/null pnpm audit --audit-level high --registry=https://registry.npmjs.org/"
    },
    {
      "language": "typescript",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "package-lock.json" },
      "tool": "npm audit",
      "install": "corepack enable npm",
      "probe": ["npm"],
      "command": "env -i PATH=\"$PATH\" HOME=\"$HOME\" npm_config_userconfig=/dev/null npm audit --audit-level=high --registry=https://registry.npmjs.org/"
    },
    {
      "language": "go",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "go.mod" },
      "tool": "govulncheck",
      "install": "go install golang.org/x/vuln/cmd/govulncheck@latest",
      "probe": ["govulncheck"],
      "command": "govulncheck -db https://vuln.go.dev ./..."
    },
    {
      "language": "rust",
      "slot": "DEPENDENCY_AUDIT",
      "signal": { "kind": "file", "path": "Cargo.lock" },
      "tool": "cargo-audit",
      "install": "cargo install cargo-audit --locked",
      "probe": ["cargo-audit"],
      "command": "cargo audit --url https://github.com/RustSec/advisory-db.git"
    }
  ]
}
