{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable task metadata",
  "description": "The native Tasks workflow authors this sidecar; the runner binds definitions and derives routing. Completion evidence remains native-orchestrator-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fingerprints", "tasks"],
  "properties": {
    "schema_version": {"const": "task-execution.v1"},
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_sha256", "plan_sha256", "tasks_sha256"],
      "properties": {
        "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tasks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": {"pattern": "^T[0-9]{3,}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_group", "depends_on", "owns", "tdd_unit"],
        "properties": {
          "capability_group": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "tdd_unit": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}},
          "owns": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "description": "Canonical repository-relative ownership, including shared fixtures and generated inputs. Runtime checks root-level and escaping references, NFC/case-insensitive overlap and filesystem identity. Hard-linked files, symlink descendants, special files and directory ownership exceeding 10000 entries fail closed; declare narrower explicit roots.",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
