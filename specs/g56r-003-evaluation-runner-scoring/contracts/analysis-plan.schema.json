{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/g56r-003/analysis-plan.schema.json",
  "title": "G56R-003 Frozen Analysis Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_plan_id",
    "analysis_plan_digest",
    "status",
    "calibration_protocol_binding",
    "calibration_completion_binding",
    "workload_manifest",
    "cache_policy",
    "quality_floors",
    "non_inferiority",
    "pareto_policy",
    "attrition_policy",
    "rerun_policy",
    "campaign_budget",
    "racing_policy",
    "futility_policy",
    "terminal_policy",
    "frozen_at",
    "pre_cohort_outcome_absence_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_plan_id": {"type": "string", "minLength": 1},
    "analysis_plan_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "frozen"},
    "calibration_protocol_binding": {"$ref": "#/$defs/binding"},
    "calibration_completion_binding": {"$ref": "#/$defs/binding"},
    "workload_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_digest",
        "minimum_unique_tasks",
        "unknown_stratum_policy",
        "guardrail_method",
        "strata"
      ],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "minimum_unique_tasks": {"type": "integer", "minimum": 1},
        "unknown_stratum_policy": {"const": "inconclusive"},
        "guardrail_method": {"$ref": "#/$defs/guardrailMethod"},
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stratum_id",
              "weight",
              "long_horizon",
              "sample_size",
              "minimum_unique_tasks",
              "p95_duration_ms_max",
              "p95_input_tokens_max",
              "p95_cached_input_tokens_max",
              "p95_output_tokens_max"
            ],
            "properties": {
              "stratum_id": {"type": "string", "minLength": 1},
              "weight": {"type": "number", "exclusiveMinimum": 0},
              "long_horizon": {"type": "boolean"},
              "sample_size": {"type": "integer", "minimum": 1},
              "minimum_unique_tasks": {"type": "integer", "minimum": 1},
              "p95_duration_ms_max": {"type": "integer", "minimum": 1},
              "p95_input_tokens_max": {"type": "integer", "minimum": 1},
              "p95_cached_input_tokens_max": {"type": "integer", "minimum": 0},
              "p95_output_tokens_max": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "cache_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_digest", "pair_isolation", "order_leakage_prohibited"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "pair_isolation": {"const": true},
        "order_leakage_prohibited": {"const": true}
      }
    },
    "quality_floors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_minimum", "reliability_minimum"],
      "properties": {
        "semantic_minimum": {"type": "number"},
        "reliability_minimum": {"type": "number"}
      }
    },
    "non_inferiority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints",
        "margins",
        "confidence_level",
        "alpha",
        "power",
        "sample_sizes",
        "sample_size_assumptions",
        "cluster_unit",
        "cluster_adjustment",
        "multiplicity_adjustment",
        "multiplicity_declaration"
      ],
      "properties": {
        "endpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "margins": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "sample_sizes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "sample_size_assumptions": {"type": "object", "minProperties": 1},
        "cluster_unit": {"enum": ["role", "fixture"]},
        "cluster_adjustment": {"type": "string", "minLength": 1},
        "multiplicity_adjustment": {"type": "string", "minLength": 1},
        "multiplicity_declaration": {"$ref": "#/$defs/multiplicityDeclaration"}
      }
    },
    "pareto_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "weights_prohibited", "mixed_or_tied_result"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input_tokens",
              "cached_input_tokens",
              "output_tokens",
              "duration",
              "retries",
              "compactions",
              "acceptance",
              "terminal_state"
            ]
          }
        },
        "weights_prohibited": {"const": true},
        "mixed_or_tied_result": {"const": "inconclusive"}
      }
    },
    "attrition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cap", "unclassifiable_result", "complete_case_filtering"],
      "properties": {
        "cap": {"type": "number", "minimum": 0, "maximum": 1},
        "unclassifiable_result": {"const": "inconclusive"},
        "complete_case_filtering": {"const": false}
      }
    },
    "rerun_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_failure", "scope", "cap"],
      "properties": {
        "eligible_failure": {"const": "independently_preclassified_transient_harness_failure"},
        "scope": {"const": "complete_pair"},
        "cap": {"type": "integer", "minimum": 0}
      }
    },
    "campaign_budget": {"$ref": "#/$defs/budget"},
    "racing_policy": {"$ref": "#/$defs/disabledRacingPolicy"},
    "futility_policy": {"$ref": "#/$defs/disabledFutilityPolicy"},
    "terminal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_failure_acceptance", "incomplete_result", "uncertain_result"],
      "properties": {
        "candidate_failure_acceptance": {"const": 0},
        "incomplete_result": {"const": "inconclusive"},
        "uncertain_result": {"const": "inconclusive"}
      }
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "pre_cohort_outcome_absence_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "guardrailMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "denominator",
        "comparator",
        "margin",
        "confidence_method",
        "missing_data_rule",
        "direction",
        "multiplicity_position",
        "breach_result",
        "decision_bearing"
      ],
      "properties": {
        "units": {"$ref": "#/$defs/guardrailUnits"},
        "denominator": {"const": "per_attempt_within_stratum_arm"},
        "comparator": {"const": "absolute_ceiling"},
        "margin": {"type": "number", "minimum": 0},
        "confidence_method": {"$ref": "#/$defs/guardrailConfidenceMethod"},
        "missing_data_rule": {"const": "report_jointly_with_attrition"},
        "direction": {"const": "higher_is_worse"},
        "multiplicity_position": {"$ref": "#/$defs/guardrailMultiplicityPosition"},
        "breach_result": {"const": "no_qualification"},
        "decision_bearing": {"const": false}
      }
    },
    "guardrailUnits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "duration_ms"
      ],
      "properties": {
        "raw_input_tokens": {"const": "tokens_per_attempt"},
        "cached_input_tokens": {"const": "tokens_per_attempt"},
        "output_tokens": {"const": "tokens_per_attempt"},
        "duration_ms": {"const": "milliseconds_per_attempt"}
      }
    },
    "guardrailConfidenceMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence_level"],
      "properties": {
        "method": {"const": "empirical_order_statistic"},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "guardrailMultiplicityPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "adjustment", "rationale"],
      "properties": {
        "family": {"const": "guardrail"},
        "adjustment": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "multiplicityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conjunctive_family",
        "pareto_disjunctive_family",
        "across_ladder_family",
        "cluster_adjustment_is_precondition"
      ],
      "properties": {
        "conjunctive_family": {"$ref": "#/$defs/multiplicityFamily"},
        "pareto_disjunctive_family": {"$ref": "#/$defs/multiplicityFamily"},
        "across_ladder_family": {"$ref": "#/$defs/multiplicityFamily"},
        "cluster_adjustment_is_precondition": {"const": true}
      }
    },
    "multiplicityFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjustment", "rationale"],
      "properties": {
        "adjustment": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "disabledRacingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "terminal_rule",
        "interim_looks",
        "boundary",
        "error_control",
        "look_schedule_frozen",
        "early_stop_biases_estimate",
        "stop_scope"
      ],
      "properties": {
        "enabled": {"const": false},
        "terminal_rule": {"const": "disabled"},
        "interim_looks": {"$ref": "#/$defs/zeroInterimLooks"},
        "boundary": {"$ref": "#/$defs/disabledBoundary"},
        "error_control": {"$ref": "#/$defs/disabledErrorControl"},
        "look_schedule_frozen": {"const": true},
        "early_stop_biases_estimate": {"const": true},
        "stop_scope": {"const": "complete_pair"}
      }
    },
    "disabledFutilityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "terminal_rule",
        "interim_looks",
        "boundary",
        "error_control",
        "look_schedule_frozen",
        "early_stop_biases_estimate",
        "stop_scope",
        "boundary_binding"
      ],
      "properties": {
        "enabled": {"const": false},
        "terminal_rule": {"const": "disabled"},
        "interim_looks": {"$ref": "#/$defs/zeroInterimLooks"},
        "boundary": {"$ref": "#/$defs/disabledBoundary"},
        "error_control": {"$ref": "#/$defs/disabledErrorControl"},
        "look_schedule_frozen": {"const": true},
        "early_stop_biases_estimate": {"const": true},
        "stop_scope": {"const": "complete_pair"},
        "boundary_binding": {"enum": ["binding", "non_binding"]}
      }
    },
    "zeroInterimLooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "information_fractions"],
      "properties": {
        "count": {"const": 0},
        "information_fractions": {"type": "array", "maxItems": 0}
      }
    },
    "disabledBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rationale"],
      "properties": {
        "type": {"const": "disabled"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "disabledErrorControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "rationale"],
      "properties": {
        "method": {"const": "none_no_interim_looks"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_duration_seconds",
        "max_input_tokens",
        "max_cached_input_tokens",
        "max_output_tokens",
        "max_candidates",
        "max_confirmation_entries"
      ],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_cached_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_confirmation_entries": {"type": "integer", "minimum": 0}
      }
    }
  }
}
