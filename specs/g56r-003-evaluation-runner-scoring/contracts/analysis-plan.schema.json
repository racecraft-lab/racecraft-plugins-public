{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/g56r-003/analysis-plan.schema.json",
  "title": "G56R-003 Frozen Analysis Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_plan_id",
    "analysis_plan_digest",
    "status",
    "calibration_protocol_binding",
    "calibration_binding",
    "workload_manifest",
    "cache_policy",
    "quality_floors",
    "non_inferiority",
    "pareto_policy",
    "attrition_policy",
    "rerun_policy",
    "campaign_budget",
    "racing_policy",
    "futility_policy",
    "terminal_policy",
    "frozen_at",
    "pre_cohort_outcome_absence_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_plan_id": {"type": "string", "minLength": 1},
    "analysis_plan_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "frozen"},
    "calibration_protocol_binding": {"$ref": "#/$defs/binding"},
    "calibration_binding": {"$ref": "#/$defs/binding"},
    "workload_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_digest",
        "minimum_unique_tasks",
        "unknown_stratum_policy",
        "strata"
      ],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "minimum_unique_tasks": {"type": "integer", "minimum": 1},
        "unknown_stratum_policy": {"const": "inconclusive"},
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stratum_id",
              "weight",
              "long_horizon",
              "p95_duration_ms_max",
              "p95_input_tokens_max",
              "p95_cached_input_tokens_max",
              "p95_output_tokens_max"
            ],
            "properties": {
              "stratum_id": {"type": "string", "minLength": 1},
              "weight": {"type": "number", "exclusiveMinimum": 0},
              "long_horizon": {"type": "boolean"},
              "p95_duration_ms_max": {"type": "integer", "minimum": 1},
              "p95_input_tokens_max": {"type": "integer", "minimum": 1},
              "p95_cached_input_tokens_max": {"type": "integer", "minimum": 0},
              "p95_output_tokens_max": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "cache_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_digest", "pair_isolation", "order_leakage_prohibited"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "pair_isolation": {"const": true},
        "order_leakage_prohibited": {"const": true}
      }
    },
    "quality_floors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_minimum", "reliability_minimum"],
      "properties": {
        "semantic_minimum": {"type": "number"},
        "reliability_minimum": {"type": "number"}
      }
    },
    "non_inferiority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints",
        "margins",
        "confidence_level",
        "alpha",
        "power",
        "sample_sizes",
        "sample_size_assumptions",
        "cluster_unit",
        "cluster_adjustment",
        "multiplicity_adjustment"
      ],
      "properties": {
        "endpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "margins": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "sample_sizes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "sample_size_assumptions": {"type": "object", "minProperties": 1},
        "cluster_unit": {"enum": ["role", "fixture"]},
        "cluster_adjustment": {"type": "string", "minLength": 1},
        "multiplicity_adjustment": {"type": "string", "minLength": 1}
      }
    },
    "pareto_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "weights_prohibited", "mixed_or_tied_result"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input_tokens",
              "cached_input_tokens",
              "output_tokens",
              "duration",
              "retries",
              "compactions",
              "acceptance",
              "terminal_state"
            ]
          }
        },
        "weights_prohibited": {"const": true},
        "mixed_or_tied_result": {"const": "inconclusive"}
      }
    },
    "attrition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cap", "unclassifiable_result", "complete_case_filtering"],
      "properties": {
        "cap": {"type": "number", "minimum": 0, "maximum": 1},
        "unclassifiable_result": {"const": "inconclusive"},
        "complete_case_filtering": {"const": false}
      }
    },
    "rerun_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_failure", "scope", "cap"],
      "properties": {
        "eligible_failure": {"const": "independently_preclassified_transient_harness_failure"},
        "scope": {"const": "complete_pair"},
        "cap": {"type": "integer", "minimum": 0}
      }
    },
    "campaign_budget": {"$ref": "#/$defs/budget"},
    "racing_policy": {"type": "object", "minProperties": 1},
    "futility_policy": {"type": "object", "minProperties": 1},
    "terminal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_failure_acceptance", "incomplete_result", "uncertain_result"],
      "properties": {
        "candidate_failure_acceptance": {"const": 0},
        "incomplete_result": {"const": "inconclusive"},
        "uncertain_result": {"const": "inconclusive"}
      }
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "pre_cohort_outcome_absence_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_duration_seconds",
        "max_input_tokens",
        "max_cached_input_tokens",
        "max_output_tokens",
        "max_candidates",
        "max_confirmation_entries"
      ],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_cached_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_confirmation_entries": {"type": "integer", "minimum": 0}
      }
    }
  }
}
