{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-007/active-path-guard-result.schema.json",
  "title": "Active Path Guard Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "blocking_count", "findings", "classified_counts"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "status": { "type": "string", "enum": ["ok", "expected_failure", "input_error"] },
    "blocking_count": { "type": "integer", "minimum": 0 },
    "classified_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "pattern", "reason", "active_role", "classification", "remediation"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "category": {
          "type": "string",
          "enum": [
            "bash",
            "script_file",
            "jq",
            "git_bash",
            "wsl",
            "powershell_helper",
            "shell_parsing",
            "shell_interpolation",
            "shell_true",
            "os_system",
            "command_string_subprocess"
          ]
        },
        "pattern": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "active_role": { "type": "string", "minLength": 1 },
        "classification": {
          "type": "string",
          "enum": [
            "blocking_active_gate",
            "ci_dispatch_glue",
            "temporary_parity_evidence",
            "archive_provenance",
            "consumer_spec_kit_helper",
            "generated_payload_mirror",
            "xplat_008_cutover_surface",
            "docs_out_of_scope"
          ]
        },
        "remediation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
