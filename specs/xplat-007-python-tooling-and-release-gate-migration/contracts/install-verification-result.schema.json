{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-007/install-verification-result.schema.json",
  "title": "Install Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "status",
    "install_root",
    "fake_home",
    "stubbed_cli",
    "bundled_agent_count",
    "expected_files",
    "missing_files",
    "checksum_mismatches",
    "command_plans",
    "safe_repairs",
    "unsafe_manual_remediations",
    "native_uat_claimed"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "verification_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["complete", "safe_repair", "blocked", "input_error"] },
    "install_root": { "type": "string", "minLength": 1 },
    "fake_home": { "type": "boolean" },
    "stubbed_cli": { "type": "boolean" },
    "bundled_agent_count": { "type": "integer", "minimum": 0 },
    "expected_files": { "type": "array", "items": { "type": "string" } },
    "missing_files": { "type": "array", "items": { "type": "string" } },
    "checksum_mismatches": { "type": "array", "items": { "type": "string" } },
    "command_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "argv"],
        "properties": {
          "operation_id": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "safe_repairs": { "type": "array", "items": { "type": "string" } },
    "unsafe_manual_remediations": { "type": "array", "items": { "type": "string" } },
    "native_uat_claimed": { "type": "boolean", "const": false }
  }
}
