{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.local/contracts/speckit-pro-runner-envelope.schema.json",
  "title": "SpecKit Pro Runner Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "helper_id", "operation", "mode", "inputs"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "helper_id": {
      "const": "runner"
    },
    "operation": {
      "type": "string",
      "enum": ["preflight", "runtime-info"]
    },
    "mode": {
      "const": "read_only"
    },
    "inputs": {
      "type": "object"
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "source", "code", "message", "remediation"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "source": {
          "const": "runner"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_json",
            "invalid_envelope",
            "unsupported_schema_version",
            "missing_required_field",
            "python_too_old",
            "python_launcher_unavailable",
            "specify_missing",
            "plugin_root_missing",
            "runner_metadata_missing",
            "runner_metadata_incomplete",
            "runner_metadata_mismatch",
            "runner_metadata_not_checked",
            "subprocess_nonzero",
            "subprocess_timeout",
            "subprocess_stderr_only_failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "remediation": {
          "$ref": "#/$defs/remediation"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "actions"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "deferred_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "typed_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "display"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["plugin_relative", "repo_relative", "absolute"]
        },
        "value": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "output_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "byte_count", "limit_bytes", "truncated"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 16384
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "limit_bytes": {
          "const": 16384
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "subprocess_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code", "stdout", "stderr", "timed_out", "timeout_seconds", "duration_ms", "stderr_is_failure"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "stdout": {
          "$ref": "#/$defs/output_capture"
        },
        "stderr": {
          "$ref": "#/$defs/output_capture"
        },
        "timed_out": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_is_failure": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "status", "exit_code", "legacy_exit_code", "diagnostics", "data"],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["ok", "expected_failure", "input_error", "missing_prerequisite", "subprocess_failure", "internal_failure"]
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "legacy_exit_code": {
          "type": ["integer", "null"]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
