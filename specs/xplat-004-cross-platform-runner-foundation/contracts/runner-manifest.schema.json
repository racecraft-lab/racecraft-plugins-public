{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.local/contracts/speckit-pro-runner-manifest.schema.json",
  "title": "SpecKit Pro Runner Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runner_name",
    "runner_contract_id",
    "selected_runtime_name",
    "contract_version",
    "plugin_version",
    "runner_version",
    "source_revision",
    "python_minimum_version",
    "specify_required",
    "checksum_algorithm",
    "runner_files"
  ],
  "properties": {
    "runner_name": {
      "const": "speckit_pro_runner"
    },
    "runner_contract_id": {
      "const": "speckit-pro-runner"
    },
    "selected_runtime_name": {
      "const": "python-stdlib-runner"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1
    },
    "runner_version": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "python_minimum_version": {
      "const": "3.11"
    },
    "specify_required": {
      "const": true
    },
    "checksum_algorithm": {
      "const": "sha256"
    },
    "runner_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "$ref": "#/$defs/typed_path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "typed_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "display"],
      "properties": {
        "kind": {
          "const": "plugin_relative"
        },
        "value": {
          "type": "string",
          "pattern": "^speckit_pro_runner/.+"
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
