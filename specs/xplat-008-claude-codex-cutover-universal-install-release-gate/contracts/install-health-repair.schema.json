{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-008/install-health-repair.schema.json",
  "title": "XPLAT-008 Install Health and Repair Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "installed_cache_path",
    "findings",
    "repair_actions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "feature_id": {
      "const": "XPLAT-008"
    },
    "installed_cache_path": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repair_action"
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "manual_remediation_required"
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "artifact_path",
        "artifact_kind",
        "source_identity",
        "release_channel_or_tag",
        "expected_digest",
        "actual_digest",
        "classification",
        "repair_allowed"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
          }
        },
        "artifact_kind": {
          "enum": [
            "generated_payload",
            "bundled_agent",
            "hook",
            "runner_file",
            "manifest",
            "checksum",
            "unknown",
            "extra"
          ]
        },
        "source_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_channel_or_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "actual_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "classification": {
          "enum": [
            "trusted_missing",
            "trusted_stale",
            "unsafe_unknown",
            "unsafe_extra",
            "unsafe_mismatch",
            "unsafe_trust_root_change",
            "unsafe_out_of_cache"
          ]
        },
        "repair_allowed": {
          "type": "boolean"
        }
      }
    },
    "repair_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "finding_id",
        "action_type",
        "target_path",
        "source_path",
        "digest_verified",
        "status",
        "message",
        "manual_steps"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "enum": [
            "autoheal_refresh",
            "manual_remediation"
          ]
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest_verified": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "completed",
            "skipped",
            "blocked"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "manual_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "autoheal_refresh"
              }
            }
          },
          "then": {
            "properties": {
              "digest_verified": {
                "const": true
              },
              "status": {
                "const": "completed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "manual_remediation"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          }
        }
      ]
    }
  }
}
