{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-008/payload-completeness.schema.json",
  "title": "XPLAT-008 Payload Completeness Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload_surface",
    "source_root",
    "generated_root",
    "plugin_version",
    "runner_version",
    "expected_files",
    "actual_files",
    "missing_paths",
    "extra_paths",
    "mismatched_paths",
    "path_leaks",
    "file_tree_hash",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "payload_surface": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "generated_root": {
      "type": "string",
      "minLength": 1
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "runner_version": {
      "type": "string",
      "minLength": 1
    },
    "expected_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/payload_file"
      }
    },
    "actual_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payload_file"
      }
    },
    "missing_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mismatched_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path_leaks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_tree_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "$defs": {
    "payload_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256",
        "required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
          }
        },
        "source_path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "manifest",
            "skill",
            "agent",
            "hook",
            "runner",
            "install_guidance",
            "trust_metadata",
            "checksum",
            "version_metadata",
            "docs"
          ]
        },
        "transform": {
          "enum": [
            "none",
            "claude_guard_strip",
            "codex_overlay",
            "path_normalization",
            "manifest_rewrite"
          ],
          "default": "none"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
