{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-008/release-readiness.schema.json",
  "title": "XPLAT-008 Release Readiness Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "status",
    "blocking_count",
    "checks",
    "payload_results",
    "uat_rows",
    "repair_actions",
    "public_claim_results",
    "runner_invocations",
    "evidence_refs",
    "traceability"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "feature_id": {
      "const": "XPLAT-008"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "blocking_count": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "payload_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/claude_payload_result"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/codex_payload_result"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/payload_result"
      }
    },
    "uat_rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/claude_windows_uat_row"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/claude_macos_uat_row"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/claude_linux_uat_row"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/codex_windows_uat_row"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/codex_macos_uat_row"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/codex_linux_uat_row"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/uat_row"
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repair_action"
      }
    },
    "public_claim_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/public_claim_result"
      }
    },
    "runner_invocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runner_invocation"
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_results",
        "uat_matrix",
        "install_health",
        "public_claims",
        "runner_invocations"
      ],
      "properties": {
        "payload_results": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uat_matrix": {
          "type": "string",
          "minLength": 1
        },
        "install_health": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runner_invocations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "changed_files",
          "verification_evidence"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^(FR|SC)-[0-9]{3}$"
          },
          "changed_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "blocker_class",
        "status",
        "blocking",
        "message",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "enum": [
            "active-runtime-guard",
            "payload-completeness",
            "bundled-agents",
            "hooks",
            "runner-files",
            "version-sync",
            "trust-metadata",
            "public-claims",
            "uat-matrix",
            "update-proof",
            "install-health-repair",
            "release-packet-traceability",
            "dist-determinism"
          ]
        },
        "blocker_class": {
          "enum": [
            "active_shell_runtime_dependency",
            "incomplete_payload",
            "missing_bundled_agent",
            "missing_hook",
            "missing_runner_file",
            "stale_metadata",
            "missing_trust_metadata",
            "unsafe_public_claim",
            "incomplete_uat_evidence",
            "unsafe_repair_claim",
            "missing_traceability",
            "nondeterministic_dist"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claude_payload_result": {
      "$ref": "#/$defs/payload_surface_result",
      "properties": {
        "payload_surface": {
          "const": "claude"
        }
      }
    },
    "codex_payload_result": {
      "$ref": "#/$defs/payload_surface_result",
      "properties": {
        "payload_surface": {
          "const": "codex"
        }
      }
    },
    "payload_surface_result": {
      "type": "object",
      "required": [
        "payload_surface"
      ],
      "properties": {
        "payload_surface": {
          "enum": [
            "claude",
            "codex"
          ]
        }
      }
    },
    "payload_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_surface",
        "plugin_version",
        "runner_version",
        "expected_files",
        "actual_files",
        "missing_paths",
        "extra_paths",
        "mismatched_paths",
        "path_leaks",
        "file_tree_hash",
        "status"
      ],
      "properties": {
        "payload_surface": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "plugin_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        },
        "expected_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/payload_file"
          }
        },
        "actual_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/payload_file"
          }
        },
        "missing_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatched_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_leaks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_tree_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "payload_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256",
        "required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
          }
        },
        "source_path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "manifest",
            "skill",
            "agent",
            "hook",
            "runner",
            "install_guidance",
            "trust_metadata",
            "checksum",
            "version_metadata",
            "docs"
          ]
        },
        "transform": {
          "enum": [
            "none",
            "claude_guard_strip",
            "codex_overlay",
            "path_normalization",
            "manifest_rewrite"
          ],
          "default": "none"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "claude_windows_uat_row": {
      "$ref": "#/$defs/product_platform_row",
      "properties": {
        "product": {
          "const": "claude"
        },
        "platform": {
          "const": "windows"
        }
      }
    },
    "claude_macos_uat_row": {
      "$ref": "#/$defs/product_platform_row",
      "properties": {
        "product": {
          "const": "claude"
        },
        "platform": {
          "const": "macos"
        }
      }
    },
    "claude_linux_uat_row": {
      "$ref": "#/$defs/product_platform_row",
      "properties": {
        "product": {
          "const": "claude"
        },
        "platform": {
          "const": "linux"
        }
      }
    },
    "codex_windows_uat_row": {
      "$ref": "#/$defs/product_platform_row",
      "properties": {
        "product": {
          "const": "codex"
        },
        "platform": {
          "const": "windows"
        }
      }
    },
    "codex_macos_uat_row": {
      "$ref": "#/$defs/product_platform_row",
      "properties": {
        "product": {
          "const": "codex"
        },
        "platform": {
          "const": "macos"
        }
      }
    },
    "codex_linux_uat_row": {
      "$ref": "#/$defs/product_platform_row",
      "properties": {
        "product": {
          "const": "codex"
        },
        "platform": {
          "const": "linux"
        }
      }
    },
    "product_platform_row": {
      "type": "object",
      "required": [
        "product",
        "platform"
      ],
      "properties": {
        "product": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        }
      }
    },
    "uat_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "platform",
        "operator",
        "date",
        "host_version",
        "plugin_version_or_latest_tag",
        "installed_cache_path",
        "interpreter_resolution",
        "runner_invocation_ids",
        "install_result",
        "bundled_agent_verification",
        "first_use",
        "scaffold_status",
        "autopilot_dry_run",
        "latest_tag_update",
        "incomplete_install_repair",
        "expected_result",
        "actual_result",
        "evidence_link",
        "operator_notes",
        "status"
      ],
      "properties": {
        "product": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "host_version": {
          "type": "string",
          "minLength": 1
        },
        "plugin_version_or_latest_tag": {
          "type": "string",
          "minLength": 1
        },
        "installed_cache_path": {
          "type": "string",
          "minLength": 1
        },
        "interpreter_resolution": {
          "type": "object"
        },
        "runner_invocation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "install_result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "bundled_agent_verification": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "first_use": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "scaffold_status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "autopilot_dry_run": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "latest_tag_update": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "incomplete_install_repair": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "actual_result": {
          "type": "string",
          "minLength": 1
        },
        "evidence_link": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "<a\\s"
          }
        },
        "operator_notes": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "repair_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "finding_id",
        "action_type",
        "target_path",
        "source_path",
        "digest_verified",
        "status",
        "message",
        "manual_steps"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "enum": [
            "autoheal_refresh",
            "manual_remediation"
          ]
        },
        "target_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
          }
        },
        "source_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
              }
            }
          ]
        },
        "digest_verified": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "completed",
            "skipped",
            "blocked"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "manual_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "autoheal_refresh"
              }
            }
          },
          "then": {
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
                }
              },
              "digest_verified": {
                "const": true
              },
              "status": {
                "const": "completed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "manual_remediation"
              }
            }
          },
          "then": {
            "properties": {
              "source_path": {
                "const": null
              },
              "digest_verified": {
                "const": false
              },
              "status": {
                "const": "blocked"
              },
              "manual_steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "public_claim_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim_id",
        "surface",
        "claim_text_or_pattern",
        "status",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "claim_text_or_pattern": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runner_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "product",
        "platform",
        "surface_path",
        "operation",
        "interpreter_resolution",
        "invocation",
        "runner_request",
        "runner_response",
        "status",
        "diagnostics"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "surface_path": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "preflight",
            "scaffold",
            "status",
            "autopilot-dry-run",
            "doctor",
            "update",
            "autoheal"
          ]
        },
        "interpreter_resolution": {
          "$ref": "#/$defs/interpreter_resolution"
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "stdin_mode",
            "stdout_mode",
            "stderr_mode",
            "shell_used"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "oneOf": [
                {
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "const": "-m"
                    },
                    {
                      "const": "speckit_pro_runner"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "pattern": "^-"
                    },
                    {
                      "const": "-m"
                    },
                    {
                      "const": "speckit_pro_runner"
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "maxItems": 0
                }
              ]
            },
            "stdin_mode": {
              "const": "single_json_request"
            },
            "stdout_mode": {
              "const": "single_json_response"
            },
            "stderr_mode": {
              "const": "diagnostics_only"
            },
            "shell_used": {
              "const": false
            }
          }
        },
        "runner_request": {
          "type": "object"
        },
        "runner_response": {
          "type": [
            "object",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "interpreter_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted_candidates",
        "resolved_executable",
        "invocation_argv_prefix",
        "version",
        "accepted",
        "minimum_version",
        "failure_code",
        "diagnostic"
      ],
      "properties": {
        "attempted_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolved_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_argv_prefix": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "minimum_version": {
          "const": "3.11"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "object"
        }
      }
    }
  }
}
