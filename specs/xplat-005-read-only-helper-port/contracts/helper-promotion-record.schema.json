{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.local/specs/xplat-005/helper-promotion-record.schema.json",
  "title": "XPLAT-005 Helper Promotion Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "helper_id",
    "slice",
    "bash_script_path",
    "runner_operation",
    "runner_module",
    "fixture_ids",
    "bash_comparison_ids",
    "failure_class_mappings",
    "normalized_fields",
    "subprocess_policy",
    "path_boundary_policy",
    "status",
    "authoritative_test_command",
    "deferred_follow_up"
  ],
  "properties": {
    "helper_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "oneOf": [
        {
          "type": "integer",
          "enum": [1, 2]
        },
        {
          "type": "string",
          "const": "N/A"
        }
      ]
    },
    "bash_script_path": {
      "type": ["string", "null"]
    },
    "runner_operation": {
      "type": ["string", "null"]
    },
    "runner_module": {
      "type": ["string", "null"]
    },
    "fixture_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bash_comparison_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normalized_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_class_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_class",
          "expected_exit_code",
          "fixture_ids"
        ],
        "properties": {
          "failure_class": {
            "type": "string",
            "enum": [
              "invalid_input",
              "missing_input",
              "malformed_json",
              "missing_file",
              "unsupported_path",
              "missing_prerequisite",
              "validation_failure",
              "subprocess_failure",
              "preflight_failure"
            ]
          },
          "expected_exit_code": {
            "type": "integer"
          },
          "stdout_schema_ref": {
            "type": ["string", "null"]
          },
          "diagnostic_code": {
            "type": ["string", "null"]
          },
          "remediation_required": {
            "type": "boolean"
          },
          "fixture_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "subprocess_policy": {
      "type": "string",
      "enum": [
        "argv_only",
        "not_applicable"
      ]
    },
    "path_boundary_policy": {
      "type": "string",
      "enum": [
        "repo_or_plugin_boundary_required",
        "not_applicable"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "python_authoritative",
        "bash_reference_only",
        "out_of_scope"
      ]
    },
    "authoritative_test_command": {
      "type": ["string", "null"]
    },
    "deferred_follow_up": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "python_authoritative"
          }
        }
      },
      "then": {
        "properties": {
          "fixture_ids": {
            "minItems": 1
          },
          "failure_class_mappings": {
            "minItems": 1
          },
          "authoritative_test_command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "out_of_scope"
          }
        }
      },
      "then": {
        "properties": {
          "deferred_follow_up": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
