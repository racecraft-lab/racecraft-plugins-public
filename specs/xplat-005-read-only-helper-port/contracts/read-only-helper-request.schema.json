{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.local/specs/xplat-005/read-only-helper-request.schema.json",
  "title": "XPLAT-005 Read-Only Helper Runner Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "helper_id",
    "operation",
    "mode",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "helper_id": {
      "type": "string",
      "enum": [
        "runner",
        "helper-registry-dispatch",
        "check-prerequisites",
        "detect-commands",
        "detect-presets",
        "count-markers",
        "validate-gate",
        "reviewability-gate",
        "estimate-reviewable-loc",
        "resolve-confidence-mode",
        "confidence-gate",
        "generate-spec-index-check",
        "o5-topology",
        "atomicity-route",
        "plan-layers-feature-dir",
        "validate-pr-workflow-contract",
        "validate-pr-packet-read-only"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "read_only"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["repo_relative", "plugin_relative", "absolute_fixture"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "trust_boundary": {
                "type": "string",
                "enum": ["repo", "plugin"]
              }
            }
          }
        },
        "failure_class": {
          "type": "string",
          "enum": [
            "none",
            "invalid_input",
            "missing_input",
            "malformed_json",
            "missing_file",
            "unsupported_path",
            "missing_prerequisite",
            "validation_failure",
            "subprocess_failure",
            "preflight_failure"
          ]
        }
      }
    }
  }
}
