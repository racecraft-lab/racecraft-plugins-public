{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/car-003/experiment-assignment.schema.json",
  "title": "CAR-003 Pre-Execution Binding Records",
  "description": "CAR-003-additive. The Codex twin publishes no assignment schema, so the Claude side authors one. A oneOf over three pre-execution binding records: the Partition Registry Entry (FR-013), the Calibration Protocol (FR-037), and the Comparison Set / Assignment (FR-037). Making these schema-enforced is what lets the bindings-exist-before-execution invariant be validated rather than assumed.",
  "oneOf": [
    {"$ref": "#/$defs/partitionRegistryEntry"},
    {"$ref": "#/$defs/calibrationProtocol"},
    {"$ref": "#/$defs/comparisonSetAssignment"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "partitionRegistryEntry": {
      "description": "FR-013: disjointness is enforced at the objective level. An objective identifier appearing in more than one registered partition's objective set fails closed with failure_plane=partition.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "partition_id",
        "partition_type",
        "qualification_eligible",
        "objective_set_digest",
        "objective_ids",
        "frozen_at",
        "owning_spec"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "partition_registry_entry"},
        "partition_id": {"type": "string", "minLength": 1},
        "partition_type": {"enum": ["calibration", "screening", "selection", "cohort_lock", "integrated_confirmation"]},
        "qualification_eligible": {"type": "boolean"},
        "objective_set_digest": {
          "description": "FR-033: SHA-256 over the canonical JSON serialization of the deduplicated, lexicographically sorted objective_ids array. Pinning the preimage is what makes two partitions listing the same objectives in different orders collide detectably.",
          "$ref": "#/$defs/digest"
        },
        "objective_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "frozen_at": {"type": "string", "format": "date-time"},
        "owning_spec": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "description": "FR-013: calibration MUST always carry qualification_eligible=false.",
          "if": {"properties": {"partition_type": {"const": "calibration"}}, "required": ["partition_type"]},
          "then": {"properties": {"qualification_eligible": {"const": false}}}
        }
      ]
    },
    "calibrationProtocol": {
      "description": "FR-037: carries no margins, sample sizes, or terminal thresholds. This is what breaks the circular dependency in which a calibration pair would otherwise have to bind an analysis plan that only freezes after calibration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "calibration_protocol_id",
        "protocol_digest",
        "partition_binding",
        "objective_bindings",
        "carries_margins",
        "carries_sample_sizes",
        "carries_terminal_thresholds",
        "frozen_at"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "calibration_protocol"},
        "calibration_protocol_id": {"type": "string", "minLength": 1},
        "protocol_digest": {"$ref": "#/$defs/digest"},
        "partition_binding": {"$ref": "#/$defs/binding"},
        "objective_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
        "carries_margins": {"const": false},
        "carries_sample_sizes": {"const": false},
        "carries_terminal_thresholds": {"const": false},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    },
    "comparisonSetAssignment": {
      "description": "FR-037: every binding exists before execution. Refreshes create additive invalidations instead of rebinding, and each rerun creates new paired assignments linked to the original comparison set.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "comparison_set_id",
        "assignment_id",
        "assignment_digest",
        "partition",
        "candidate_route_binding",
        "comparator_route_binding",
        "role_id",
        "fixture_binding",
        "task_binding",
        "instruction_hash",
        "configuration_hash",
        "capability_freeze_binding",
        "runtime_snapshot_binding",
        "route_resolution_binding",
        "materialization_binding",
        "experiment_policy_binding",
        "assigned_order",
        "pre_execution_timestamp",
        "superseded"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "comparison_set_assignment"},
        "comparison_set_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "assignment_digest": {"$ref": "#/$defs/digest"},
        "partition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["partition_id", "partition_type", "qualification_eligible"],
          "properties": {
            "partition_id": {"type": "string", "minLength": 1},
            "partition_type": {"enum": ["calibration", "screening", "selection", "cohort_lock", "integrated_confirmation"]},
            "qualification_eligible": {"type": "boolean"}
          }
        },
        "candidate_route_binding": {"$ref": "#/$defs/binding"},
        "comparator_route_binding": {"$ref": "#/$defs/binding"},
        "role_id": {"type": "string", "minLength": 1},
        "fixture_binding": {"$ref": "#/$defs/binding"},
        "task_binding": {"$ref": "#/$defs/binding"},
        "instruction_hash": {"$ref": "#/$defs/digest"},
        "configuration_hash": {"$ref": "#/$defs/digest"},
        "capability_freeze_binding": {"$ref": "#/$defs/binding"},
        "runtime_snapshot_binding": {"$ref": "#/$defs/binding"},
        "route_resolution_binding": {"$ref": "#/$defs/binding"},
        "materialization_binding": {"$ref": "#/$defs/binding"},
        "experiment_policy_binding": {"$ref": "#/$defs/binding"},
        "analysis_plan_binding": {"$ref": "#/$defs/binding"},
        "calibration_protocol_binding": {"$ref": "#/$defs/binding"},
        "assigned_order": {"type": "integer", "minimum": 0},
        "pre_execution_timestamp": {"type": "string", "format": "date-time"},
        "originating_comparison_set_id": {"type": ["string", "null"]},
        "superseded": {"type": "boolean"},
        "invalidations": {
          "description": "FR-041: additive invalidation markers. A bound pair is marked invalidated, never rebound.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "recorded_at"],
            "properties": {
              "reason": {"enum": ["none", "fixture_changed", "scorer_changed", "rubric_changed", "adjudicator_changed", "treatment_changed", "capability_changed", "partition_changed", "schema_changed", "trace_reference_integrity_failure"]},
              "recorded_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      },
      "allOf": [
        {
          "description": "FR-037: qualification-eligible pairs bind the frozen analysis plan.",
          "if": {"properties": {"partition": {"properties": {"qualification_eligible": {"const": true}}, "required": ["qualification_eligible"]}}, "required": ["partition"]},
          "then": {"required": ["analysis_plan_binding"], "not": {"required": ["calibration_protocol_binding"]}}
        },
        {
          "description": "FR-037: every qualification-ineligible pair binds the versioned calibration protocol instead, because the analysis plan does not yet exist. Keyed on qualification_eligible rather than partition_type so the two branches are exhaustive — keying on partition_type=calibration alone would leave a non-calibration ineligible partition bound to neither artifact, failing open.",
          "if": {"properties": {"partition": {"properties": {"qualification_eligible": {"const": false}}, "required": ["qualification_eligible"]}}, "required": ["partition"]},
          "then": {"required": ["calibration_protocol_binding"], "not": {"required": ["analysis_plan_binding"]}}
        }
      ]
    }
  }
}
