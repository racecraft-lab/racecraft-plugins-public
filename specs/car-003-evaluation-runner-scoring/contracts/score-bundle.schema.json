{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/car-003/score-bundle.schema.json",
  "title": "CAR-003 Score and Adjudication Bundle",
  "description": "Logical mirror of the G56R-003 spec-scoped score-bundle contract. The score_disposition, failure_plane, failure_code, and invalidation_reason enumerations are adopted verbatim per FR-034; service_reroute is the code for platform alias re-pointing and no Claude-only member is coined. resource_vector carries the eight decision-bearing Pareto dimensions per FR-018.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "score_bundle_id",
    "score_bundle_digest",
    "partition_binding",
    "assignment_binding",
    "execution_trace_binding",
    "candidate_route_binding",
    "agent_contract_binding",
    "runtime_snapshot_binding",
    "candidate_freeze_binding",
    "route_resolution_binding",
    "experiment_policy_binding",
    "treatment_contract_binding",
    "telemetry_profile_binding",
    "fixture_binding",
    "deterministic_gates",
    "ballots",
    "score_disposition",
    "failure_plane",
    "failure_code",
    "invalidation_reason",
    "resource_vector",
    "reasoning_token_report",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "score_bundle_id": {"type": "string", "minLength": 1},
    "score_bundle_digest": {"$ref": "#/$defs/digest"},
    "partition_binding": {"$ref": "#/$defs/binding"},
    "assignment_binding": {"$ref": "#/$defs/binding"},
    "execution_trace_binding": {"$ref": "#/$defs/binding"},
    "candidate_route_binding": {"$ref": "#/$defs/binding"},
    "agent_contract_binding": {"$ref": "#/$defs/binding"},
    "runtime_snapshot_binding": {"$ref": "#/$defs/binding"},
    "candidate_freeze_binding": {"$ref": "#/$defs/binding"},
    "route_resolution_binding": {"$ref": "#/$defs/binding"},
    "experiment_policy_binding": {"$ref": "#/$defs/binding"},
    "treatment_contract_binding": {"$ref": "#/$defs/binding"},
    "telemetry_profile_binding": {"$ref": "#/$defs/binding"},
    "fixture_binding": {"$ref": "#/$defs/binding"},
    "deterministic_gates": {
      "description": "FR-014: the closed hard-gate set. No ballot is collected until every required gate has passed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "pass", "evidence_digest"],
        "properties": {
          "gate": {"enum": ["role", "safety", "grounding", "mutation", "tool", "output", "acceptance"]},
          "pass": {"type": "boolean"},
          "evidence_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "ballots": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/ballot"}
    },
    "adjudication": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adjudication_id", "adjudication_digest", "adjudicator_binding", "ballot_bindings", "resolved_outcome"],
          "properties": {
            "adjudication_id": {"type": "string", "minLength": 1},
            "adjudication_digest": {"$ref": "#/$defs/digest"},
            "adjudicator_binding": {"$ref": "#/$defs/binding"},
            "ballot_bindings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/binding"}},
            "resolved_outcome": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "score_disposition": {"enum": ["accepted", "gate_failed", "non_scorable", "invalidated"]},
    "failure_plane": {"enum": ["none", "treatment", "fixture", "scorer", "ballot", "adjudication", "candidate", "infrastructure", "evidence_boundary", "partition", "schema"]},
    "failure_code": {
      "enum": [
        "none",
        "treatment_misdelivery",
        "service_reroute",
        "mandatory_telemetry_missing",
        "treatment_infrastructure_failure",
        "fixture_invalid",
        "fixture_stale",
        "fixture_partition_invalid",
        "fixture_oracle_invalid",
        "scorer_invalid",
        "scorer_stale",
        "scorer_calibration_missing",
        "ballot_missing",
        "ballot_non_blind",
        "ballot_provenance_incomplete",
        "ballot_rubric_stale",
        "adjudication_disagreement_unresolved",
        "adjudicator_invalid",
        "adjudicator_stale",
        "adjudicator_reused_primary_scorer",
        "candidate_failed",
        "candidate_timed_out",
        "candidate_cancelled",
        "candidate_budget_exhausted",
        "candidate_abandoned",
        "transient_harness_failure",
        "infrastructure_failure",
        "unclassifiable_attrition",
        "sensitive_evidence_violation",
        "required_evidence_missing",
        "partition_mismatch",
        "partition_not_eligible",
        "cross_partition_reuse",
        "schema_invalid",
        "binding_digest_mismatch"
      ]
    },
    "invalidation_reason": {"enum": ["none", "fixture_changed", "scorer_changed", "rubric_changed", "adjudicator_changed", "treatment_changed", "capability_changed", "partition_changed", "schema_changed"]},
    "semantic_score": {"type": ["number", "null"]},
    "reliability_score": {"type": ["number", "null"]},
    "resource_vector": {
      "description": "FR-018: exactly the eight decision-bearing Pareto dimensions, identical to the Codex twin's frozen policy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "duration_ms", "retries", "compactions", "acceptance", "terminal_state"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "compactions": {"type": "integer", "minimum": 0},
        "acceptance": {"type": ["number", "null"]},
        "terminal_state": {"enum": ["completed", "failed", "timed_out", "cancelled", "budget_exhausted", "abandoned"]}
      }
    },
    "reasoning_token_report": {
      "description": "FR-049: recorded and reported for every attempt, never a decision-bearing dimension while the Codex twin's frozen Pareto policy omits it. The stated_limitation field keeps the omission visible to a reviewer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reasoning_output_tokens", "decision_bearing", "stated_limitation"],
      "properties": {
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "decision_bearing": {"const": false},
        "stated_limitation": {"type": "string", "minLength": 1}
      }
    },
    "blinding_residual": {
      "description": "FR-048: blinding is reported as bounded, not claimed complete. A recorded inference does not silently invalidate the ballot but must be reported alongside any qualification claim.",
      "type": "object",
      "additionalProperties": false,
      "required": ["leak_check_passed", "provenance_inferred"],
      "properties": {
        "leak_check_passed": {"type": "boolean"},
        "provenance_inferred": {"type": "boolean"},
        "inference_signal": {
          "description": "FR-048: the first inferring ballot's signal. Retained because already-committed bundles carry it; read inference_signals for the complete residual.",
          "type": ["string", "null"]
        },
        "inference_signals": {
          "description": "FR-048: every inferring ballot's signal, in ballot order. Reporting only the first understated the residual precisely when several scorers independently inferred provenance. CAR-owned, not a mirror surface: blinding_residual has no counterpart in G56R-003, whose requirements stop at FR-038, so this addition creates no parity divergence and the twin owes nothing. The mirrored surfaces of this contract are the four closed enumerations, which are untouched and verified byte-identical to the twin's.",
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "ballot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ballot_id", "ballot_digest", "scorer_binding", "scorer_execution_id", "calibration_binding", "rubric_binding", "blinded_artifact_digest", "criterion_scores", "provenance_inferred"],
      "properties": {
        "ballot_id": {"type": "string", "minLength": 1},
        "ballot_digest": {"$ref": "#/$defs/digest"},
        "scorer_binding": {"$ref": "#/$defs/binding"},
        "scorer_execution_id": {"type": "string", "minLength": 1},
        "calibration_binding": {"$ref": "#/$defs/binding"},
        "rubric_binding": {"$ref": "#/$defs/binding"},
        "blinded_artifact_digest": {
          "description": "FR-035: exactly one blinded-artifact digest is the ballot's sole scored input.",
          "$ref": "#/$defs/digest"
        },
        "criterion_scores": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "provenance_inferred": {
          "description": "FR-048: whether the scorer inferred candidate provenance, and from what signal.",
          "type": "boolean"
        },
        "inference_signal": {"type": ["string", "null"]},
        "presentation_order_seed": {"type": ["string", "null"]}
      }
    }
  }
}
