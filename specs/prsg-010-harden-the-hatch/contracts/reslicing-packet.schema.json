{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft-lab/racecraft-plugins-public/prsg-010/reslicing-packet.schema.json",
  "title": "Final reviewability re-slicing packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "feature",
    "diff",
    "gate",
    "exceptions",
    "blocked_operations",
    "no_pr_assertions",
    "sizing",
    "layer_plan",
    "handoff",
    "suggested_slice_boundaries",
    "resume"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "final_reviewability_reslicing_packet" },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "feature_dir", "spec_id", "title"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "feature_dir": { "type": "string", "pattern": "^specs/" },
        "spec_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": true,
      "required": ["base_ref", "head_ref", "changed_files"],
      "properties": {
        "base_ref": { "type": "string", "minLength": 1 },
        "head_ref": { "type": "string", "minLength": 1 },
        "changed_files": { "type": "integer", "minimum": 0 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "reason", "metrics"],
      "properties": {
        "status": { "type": "string", "enum": ["block"] },
        "reason": { "type": "string", "minLength": 1 },
        "metrics": { "type": "object", "additionalProperties": true }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected"],
      "properties": {
        "accepted": {
          "type": "array",
          "items": { "$ref": "#/$defs/exceptionEvidence" }
        },
        "rejected": {
          "type": "array",
          "items": { "$ref": "#/$defs/exceptionEvidence" }
        }
      }
    },
    "blocked_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pr-body-generation", "single-pr-create", "multi-pr-emission"]
      },
      "contains": { "const": "pr-body-generation" },
      "uniqueItems": true
    },
    "no_pr_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_created", "pr", "pr_body_generated", "single_pr_create_invoked", "multi_pr_emission_invoked"],
      "properties": {
        "pr_created": { "const": false },
        "pr": { "type": "null" },
        "pr_body_generated": { "const": false },
        "single_pr_create_invoked": { "const": false },
        "multi_pr_emission_invoked": { "const": false }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "layer_plan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "path": { "type": ["string", "null"] }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "command_template", "required_inputs"],
      "properties": {
        "tool": { "const": "multi-pr-emission.sh" },
        "command_template": { "type": "string", "minLength": 1 },
        "required_inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "suggested_slice_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "rationale", "paths"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "next_action", "operator_message"],
      "properties": {
        "status": { "const": "reslicing_required" },
        "next_action": { "type": "string", "minLength": 1 },
        "operator_message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "exceptionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "class", "provenance", "branch_added", "honored", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "class": {
          "type": ["string", "null"],
          "enum": ["refactor", "infra", "upgrade", null]
        },
        "provenance": {
          "type": "string",
          "enum": ["contract", "generated", "process", "template", "pr-description", "commit-message", "code-fence", "unknown"]
        },
        "branch_added": { "type": "boolean" },
        "honored": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
