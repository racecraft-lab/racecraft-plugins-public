{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/g56r-002/treatment-record.schema.json",
  "title": "G56R-002 Telemetry, Route Resolution, and Exact-Treatment Replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "telemetry_profile_id",
    "telemetry_profile",
    "controlled_environments",
    "qualification_evidence_registry",
    "route_resolutions",
    "treatment_traces",
    "fixture_provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "telemetry_profile_id": {"$ref": "#/$defs/digest"},
    "telemetry_profile": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/telemetryProfileEntry"}
    },
    "controlled_environments": {
      "type": "array",
      "items": {"$ref": "#/$defs/controlledEnvironmentBinding"}
    },
    "qualification_evidence_registry": {
      "type": "array",
      "items": {"$ref": "#/$defs/qualificationEvidenceReference"}
    },
    "route_resolutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/routeResolution"}
    },
    "treatment_traces": {
      "type": "array",
      "items": {"$ref": "#/$defs/treatmentTrace"}
    },
    "fixture_provenance": {"$ref": "#/$defs/fixtureProvenance"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "observation_state", "value", "evidence_ref", "captured_at"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1},
        "observation_state": {
          "enum": [
            "observed_value",
            "explicit_null",
            "missing",
            "unavailable",
            "not_applicable",
            "undocumented"
          ]
        },
        "value": {},
        "evidence_ref": {"type": ["string", "null"]},
        "captured_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "if": {
        "properties": {
          "observation_state": {"const": "observed_value"}
        }
      },
      "then": {
        "properties": {
          "value": {"not": {"type": "null"}}
        }
      },
      "else": {
        "properties": {
          "value": {"type": "null"}
        }
      }
    },
    "telemetryProfileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_identity_id",
        "surface",
        "field_path",
        "classification",
        "official_source_ledger_id",
        "condition",
        "completeness_rule",
        "observation_state_rules",
        "permitted_claims",
        "prohibited_claims"
      ],
      "properties": {
        "client_identity_id": {"$ref": "#/$defs/digest"},
        "surface": {"enum": ["app_server", "cli", "interactive_picker"]},
        "field_path": {"type": "string", "minLength": 1},
        "classification": {
          "enum": [
            "stable_native",
            "experimental_native",
            "derived_from_controlled_configuration",
            "conditional",
            "unavailable",
            "not_applicable",
            "undocumented"
          ]
        },
        "official_source_ledger_id": {
          "type": ["string", "null"],
          "pattern": "^OPENAI-DOC-[0-9]{3}$"
        },
        "condition": {"type": ["string", "null"]},
        "completeness_rule": {"type": "string", "minLength": 1},
        "observation_state_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_states", "value_rule", "evidence_rule"],
          "properties": {
            "allowed_states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "observed_value",
                  "explicit_null",
                  "missing",
                  "unavailable",
                  "not_applicable",
                  "undocumented"
                ]
              }
            },
            "value_rule": {"type": "string", "minLength": 1},
            "evidence_rule": {"type": "string", "minLength": 1}
          }
        },
        "permitted_claims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "prohibited_claims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": ["stable_native", "experimental_native"]
              }
            },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "official_source_ledger_id": {
                "type": "string",
                "pattern": "^OPENAI-DOC-[0-9]{3}$"
              }
            }
          }
        }
      ]
    },
    "configuredRouteProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "profile_entry_key",
        "named_agent",
        "model",
        "effort",
        "candidate_route_id",
        "agent_contract_id",
        "instruction_hash",
        "configuration_hash",
        "client_identity_id",
        "controlled_overrides",
        "launch_id",
        "consumption_evidence_digest",
        "reroute_monitoring_complete"
      ],
      "properties": {
        "proof_id": {"$ref": "#/$defs/digest"},
        "profile_entry_key": {"type": "string", "minLength": 1},
        "named_agent": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "candidate_route_id": {"type": "string", "minLength": 1},
        "agent_contract_id": {"type": "string", "minLength": 1},
        "instruction_hash": {"$ref": "#/$defs/digest"},
        "configuration_hash": {"$ref": "#/$defs/digest"},
        "client_identity_id": {"$ref": "#/$defs/digest"},
        "controlled_overrides": {"type": "object"},
        "launch_id": {"type": "string", "minLength": 1},
        "consumption_evidence_digest": {"$ref": "#/$defs/digest"},
        "reroute_monitoring_complete": {"type": "boolean"}
      }
    },
    "routeResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_resolution_id",
        "preferred_route_id",
        "attempted_route_ids",
        "assigned_route_id",
        "supported_effective_route_id",
        "fallback_index",
        "fallback_reason",
        "runtime_capability_snapshot_id",
        "resolved_at"
      ],
      "properties": {
        "route_resolution_id": {"type": "string", "minLength": 1},
        "preferred_route_id": {"type": "string", "minLength": 1},
        "attempted_route_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "assigned_route_id": {"type": "string", "minLength": 1},
        "supported_effective_route_id": {"type": ["string", "null"]},
        "fallback_index": {"type": "integer", "minimum": 0},
        "fallback_reason": {"type": ["string", "null"]},
        "runtime_capability_snapshot_id": {"$ref": "#/$defs/digest"},
        "resolved_at": {"type": "string", "format": "date-time"}
      }
    },
    "serviceRerouteEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "surface", "threadId", "turnId", "fromModel", "toModel", "reason", "evidence_digest"],
      "properties": {
        "event_id": {"$ref": "#/$defs/digest"},
        "surface": {"enum": ["app_server", "cli", "interactive_picker"]},
        "threadId": {"type": "string", "minLength": 1},
        "turnId": {"type": "string", "minLength": 1},
        "fromModel": {"type": "string", "minLength": 1},
        "toModel": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "rerouteDestinationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "destination_candidate_route_id",
        "destination_agent_contract_id",
        "destination_named_agent",
        "assessment",
        "prequalification_evidence_id"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/digest"},
        "destination_candidate_route_id": {"type": ["string", "null"], "minLength": 1},
        "destination_agent_contract_id": {"type": ["string", "null"], "minLength": 1},
        "destination_named_agent": {"type": ["string", "null"], "minLength": 1},
        "assessment": {
          "enum": [
            "prequalified_same_agent",
            "not_prequalified",
            "unknown",
            "ambiguous",
            "different_agent"
          ]
        },
        "prequalification_evidence_id": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      }
    },
    "qualificationEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_evidence_id",
        "authority_kind",
        "owner_spec_id",
        "destination_candidate_route_id",
        "destination_agent_contract_id",
        "destination_named_agent",
        "qualification_status",
        "evidence_digest"
      ],
      "properties": {
        "qualification_evidence_id": {"$ref": "#/$defs/digest"},
        "authority_kind": {"enum": ["synthetic_fixture", "owned_external"]},
        "owner_spec_id": {"type": "string", "minLength": 1},
        "destination_candidate_route_id": {"type": "string", "minLength": 1},
        "destination_agent_contract_id": {"type": "string", "minLength": 1},
        "destination_named_agent": {"type": "string", "minLength": 1},
        "qualification_status": {"const": "prequalified"},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "controlledEnvironmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlled_environment_id",
        "client_identity_id",
        "surface",
        "runtime_capability_snapshot_id",
        "repository_revision",
        "repository_tree_digest",
        "candidate_route_id",
        "work_item_kind",
        "work_item_id"
      ],
      "properties": {
        "controlled_environment_id": {"$ref": "#/$defs/digest"},
        "client_identity_id": {"$ref": "#/$defs/digest"},
        "surface": {"enum": ["app_server", "cli", "interactive_picker"]},
        "runtime_capability_snapshot_id": {"$ref": "#/$defs/digest"},
        "repository_revision": {"type": "string", "minLength": 1},
        "repository_tree_digest": {"$ref": "#/$defs/digest"},
        "candidate_route_id": {"type": "string", "minLength": 1},
        "work_item_kind": {"enum": ["task", "fixture", "objective"]},
        "work_item_id": {"type": "string", "minLength": 1}
      }
    },
    "treatmentFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_code",
        "affected_field",
        "expected_evidence_ref",
        "observed_evidence_ref",
        "resulting_disposition"
      ],
      "properties": {
        "failure_code": {
          "enum": [
            "agent_mismatch",
            "model_mismatch",
            "effort_mismatch",
            "configuration_mismatch",
            "sandbox_approvals_mismatch",
            "mutation_class_mismatch",
            "skills_mcp_tools_mismatch",
            "parent_configuration_mismatch",
            "client_or_override_mismatch",
            "delivery_canary_failure",
            "effective_treatment_unknown",
            "reroute_unapproved",
            "reroute_unidentifiable",
            "reroute_ambiguous",
            "reroute_different_agent"
          ]
        },
        "affected_field": {"type": "string", "minLength": 1},
        "expected_evidence_ref": {"type": ["string", "null"]},
        "observed_evidence_ref": {"type": ["string", "null"]},
        "resulting_disposition": {
          "enum": ["unknown", "non_scorable_rerouted", "hard_fail"]
        }
      }
    },
    "objectiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_route_id",
        "agent_contract_id",
        "runtime_capability_snapshot_id",
        "route_resolution_id",
        "experiment_policy_id",
        "execution_trace_id"
      ],
      "properties": {
        "candidate_route_id": {"type": "string", "minLength": 1},
        "agent_contract_id": {"type": "string", "minLength": 1},
        "runtime_capability_snapshot_id": {"$ref": "#/$defs/digest"},
        "route_resolution_id": {"type": "string", "minLength": 1},
        "experiment_policy_id": {"type": "string", "minLength": 1},
        "execution_trace_id": {"type": "string", "minLength": 1}
      }
    },
    "treatmentTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_binding",
        "controlled_environment_id",
        "named_agent",
        "assigned_route_id",
        "requested_model",
        "requested_effort",
        "supported_effective_model",
        "supported_effective_effort",
        "configured_route_proof",
        "service_reroute_events",
        "reroute_destination_assessments",
        "instruction_hash",
        "sandbox",
        "approvals",
        "mutation_class",
        "expected_skills_mcp_tools",
        "loaded_skills_mcp_tools",
        "parent_configuration",
        "client_identity_id",
        "controlled_overrides",
        "delivery_canary",
        "treatment_failures",
        "context",
        "parent_child_graph",
        "raw_token_vector",
        "request_turn_count",
        "wall_time_ms",
        "retries",
        "compaction",
        "validation",
        "cancellation",
        "failed_abandoned_work",
        "terminal_state",
        "outcome",
        "acceptance",
        "observations",
        "treatment_disposition",
        "disposition_reasons"
      ],
      "properties": {
        "objective_binding": {"$ref": "#/$defs/objectiveBinding"},
        "controlled_environment_id": {"$ref": "#/$defs/digest"},
        "named_agent": {"type": "string", "minLength": 1},
        "assigned_route_id": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "requested_effort": {"type": "string", "minLength": 1},
        "supported_effective_model": {"type": ["string", "null"]},
        "supported_effective_effort": {"type": ["string", "null"]},
        "configured_route_proof": {
          "oneOf": [{"$ref": "#/$defs/configuredRouteProof"}, {"type": "null"}]
        },
        "service_reroute_events": {
          "type": "array",
          "items": {"$ref": "#/$defs/serviceRerouteEvent"}
        },
        "reroute_destination_assessments": {
          "type": "array",
          "items": {"$ref": "#/$defs/rerouteDestinationAssessment"}
        },
        "instruction_hash": {"$ref": "#/$defs/digest"},
        "sandbox": {"type": "object"},
        "approvals": {"type": "object"},
        "mutation_class": {"type": "string", "minLength": 1},
        "expected_skills_mcp_tools": {"type": "array"},
        "loaded_skills_mcp_tools": {"type": "array"},
        "parent_configuration": {"type": "object"},
        "client_identity_id": {"$ref": "#/$defs/digest"},
        "controlled_overrides": {"type": "object"},
        "delivery_canary": {"type": "object"},
        "treatment_failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/treatmentFailure"}
        },
        "context": {"type": "object"},
        "parent_child_graph": {"type": "object"},
        "raw_token_vector": {"type": "object"},
        "request_turn_count": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "retries": {"type": ["integer", "null"], "minimum": 0},
        "compaction": {"type": "object"},
        "validation": {"type": "object"},
        "cancellation": {"type": "object"},
        "failed_abandoned_work": {"type": "object"},
        "terminal_state": {"type": "string", "minLength": 1},
        "outcome": {},
        "acceptance": {"type": ["boolean", "null"]},
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/observationValue"}
        },
        "treatment_disposition": {
          "enum": ["proven", "unknown", "non_scorable_rerouted", "hard_fail"]
        },
        "disposition_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixtureProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sanitizer_version",
        "raw_evidence_digest",
        "expected_dispositions",
        "network_required",
        "raw_store_required",
        "replay_count"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "sanitizer_version": {"type": "string", "minLength": 1},
        "raw_evidence_digest": {"$ref": "#/$defs/digest"},
        "expected_dispositions": {
          "type": "array",
          "items": {
            "enum": ["proven", "unknown", "non_scorable_rerouted", "hard_fail"]
          }
        },
        "network_required": {"const": false},
        "raw_store_required": {"const": false},
        "replay_count": {"const": 2}
      }
    }
  }
}
