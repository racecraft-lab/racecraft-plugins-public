{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.local/specs/g56r-002/marker-checkpoint.schema.json",
  "title": "G56R-002 Marker Checkpoint Evidence",
  "description": "Checkpoint evidence whose whole-file and marker-scoped task fingerprints can be reproduced at the recorded implementation checkpoint and at the current tree.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "marker_id",
    "status",
    "task_ids",
    "implementation_checkpoint_sha",
    "verification",
    "source_fingerprint_status",
    "source_fingerprint_contract",
    "tasks_sha",
    "tasks_sha_scope",
    "current_tasks_sha",
    "checkpoint_marker_tasks_sha",
    "current_marker_tasks_sha",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "marker-checkpoint.v1"
    },
    "feature_id": {
      "const": "G56R-002"
    },
    "marker_id": {
      "pattern": "^us[1-3]$"
    },
    "status": {
      "enum": [
        "pending",
        "complete"
      ]
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{3}$"
      }
    },
    "implementation_checkpoint_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "last_reviewed_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verification": {
      "type": "object",
      "minProperties": 1
    },
    "source_fingerprint_status": {
      "const": "current_marker_scope"
    },
    "source_fingerprint_contract": {
      "const": "marker-task-lines.v2",
      "description": "Select exact UTF-8 tasks.md lines matching ^- \\[[ xX]\\] (T[0-9]+)\\b whose task ID is in task_ids, preserve file order and line bytes, join selected lines with LF, append one final LF, then prefix the lowercase SHA-256 hex digest with sha256:."
    },
    "tasks_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tasks_sha_scope": {
      "const": "checkpoint_time_whole_file"
    },
    "current_tasks_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpoint_marker_tasks_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "marker-task-lines.v2 digest recomputed from tasks.md at implementation_checkpoint_sha."
    },
    "current_marker_tasks_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "marker-task-lines.v2 digest recomputed from the current tasks.md bytes; current_marker_scope requires equality with checkpoint_marker_tasks_sha."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
