{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-006/helper-promotion-record.schema.json",
  "title": "Helper Promotion Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["helper_id", "promotion_status", "fixture_ids", "bash_reference_ids", "rollback"],
  "properties": {
    "helper_id": { "type": "string", "minLength": 1 },
    "promotion_status": {
      "type": "string",
      "enum": ["golden_only", "bash_compared", "deferred", "out_of_scope"]
    },
    "fixture_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "bash_reference_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "authoritative_python_command": { "type": "string" },
    "rollback": { "type": "string", "minLength": 1 }
  }
}
