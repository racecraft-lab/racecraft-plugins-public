{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-007/release-readiness-result.schema.json",
  "title": "Release Readiness Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "checks",
    "blocking_count",
    "promotion_record_count",
    "test_payload_evidence_ids",
    "install_verification_ids",
    "active_path_guard_summary",
    "xplat_008_handoff_items"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "status": { "type": "string", "enum": ["pass", "fail", "input_error"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "blocking", "evidence"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "blocking": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "blocking_count": { "type": "integer", "minimum": 0 },
    "promotion_record_count": { "type": "integer", "minimum": 0 },
    "test_payload_evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "install_verification_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "active_path_guard_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_count"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "expected_failure", "input_error"] },
        "blocking_count": { "type": "integer", "minimum": 0 }
      }
    },
    "xplat_008_handoff_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "category", "owner_spec", "required_before_public_claim"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "active_invocation_cutover",
              "generated_release_payload",
              "public_docs",
              "release_notes",
              "installed_cache_uat",
              "native_platform_uat",
              "update",
              "autoheal",
              "public_release_readiness"
            ]
          },
          "owner_spec": { "type": "string", "const": "XPLAT-008" },
          "required_before_public_claim": { "type": "boolean" }
        }
      }
    }
  }
}
