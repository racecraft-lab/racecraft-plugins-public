{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-007/migrated-gate-result.schema.json",
  "title": "Migrated Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "exit_code", "legacy_exit_code", "diagnostics", "data"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["ok", "expected_failure", "input_error", "missing_prerequisite", "subprocess_failure", "internal_failure"]
    },
    "exit_code": { "type": "integer", "enum": [0, 1, 2, 3, 4, 5] },
    "legacy_exit_code": { "type": ["integer", "null"] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gate": { "$ref": "#/$defs/gate" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "source", "code", "message", "remediation"],
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "source": { "type": "string", "const": "runner" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" },
        "remediation": {
          "type": "object",
          "required": ["summary", "actions"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "actions": { "type": "array", "items": { "type": "string" } },
            "deferred_to": { "type": "string" }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "operation", "gate_status", "promoted", "blocking"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "gate_status": { "type": "string", "enum": ["pass", "fail", "skipped", "input_error"] },
        "promoted": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "comparison_ids": { "type": "array", "items": { "type": "string" } },
        "promotion_record": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["fixture", "evidence", "report", "payload", "metadata"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
