{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mutation helper request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "helper_id", "operation", "mode", "inputs"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "helper_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["read_only", "dry_run", "apply"]
    },
    "inputs": {
      "type": "object"
    }
  }
}
