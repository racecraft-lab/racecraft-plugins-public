{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autopilot phase coverage report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "type": "string", "enum": ["pass", "fail", "input_error"] },
    "code": { "type": "string" },
    "message": { "type": "string" },
    "workflow_file": { "type": "string" },
    "state_file": { "type": "string" },
    "plan_step_count": { "type": "integer", "minimum": 0 },
    "missing_workflow_sections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_workflow_tokens": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_workflow_post_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_state_prefixes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_state_post_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "duplicate_state_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "state_order_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "in_progress_errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["pass", "fail"] } }, "required": ["status"] },
      "then": {
        "required": [
          "workflow_file",
          "state_file",
          "plan_step_count",
          "missing_workflow_sections",
          "missing_workflow_tokens",
          "missing_workflow_post_items",
          "missing_state_prefixes",
          "missing_state_post_items",
          "duplicate_state_steps",
          "state_order_errors",
          "in_progress_errors"
        ]
      }
    },
    {
      "if": { "properties": { "status": { "const": "input_error" } }, "required": ["status"] },
      "then": { "required": ["code", "message"] }
    }
  ]
}
