{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed-plugin release readiness contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "blocking_count",
    "checks",
    "payload_results",
    "runner_invocations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "contract_id": {
      "const": "installed-plugin-release"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "blocking_count": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "payload_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "oneOf": [
        {
          "prefixItems": [
            {
              "$ref": "#/$defs/claude_payload_result"
            },
            {
              "$ref": "#/$defs/codex_payload_result"
            }
          ]
        },
        {
          "prefixItems": [
            {
              "$ref": "#/$defs/codex_payload_result"
            },
            {
              "$ref": "#/$defs/claude_payload_result"
            }
          ]
        }
      ],
      "items": {
        "$ref": "#/$defs/payload_result"
      }
    },
    "runner_invocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runner_invocation"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "blocking_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        }
      },
      "then": {
        "properties": {
          "blocking_count": {
            "minimum": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "blocker_class",
        "status",
        "blocking",
        "message",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "enum": [
            "active-runtime-guard",
            "payload-completeness",
            "runner-invocations",
            "version-sync",
            "zero-bash-guard",
            "repo_bash_confinement"
          ]
        },
        "blocker_class": {
          "enum": [
            "active_shell_runtime_dependency",
            "active_zero_bash_dependency",
            "active_repo_bash_dependency",
            "incomplete_payload",
            "missing_runner_invocation",
            "stale_metadata"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claude_payload_result": {
      "$ref": "#/$defs/payload_surface_result",
      "properties": {
        "payload_surface": {
          "const": "claude"
        }
      }
    },
    "codex_payload_result": {
      "$ref": "#/$defs/payload_surface_result",
      "properties": {
        "payload_surface": {
          "const": "codex"
        }
      }
    },
    "payload_surface_result": {
      "type": "object",
      "required": [
        "payload_surface"
      ],
      "properties": {
        "payload_surface": {
          "enum": [
            "claude",
            "codex"
          ]
        }
      }
    },
    "payload_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_surface",
        "plugin_version",
        "runner_version",
        "expected_files",
        "actual_files",
        "missing_paths",
        "extra_paths",
        "mismatched_paths",
        "path_leaks",
        "script_file_count",
        "file_tree_hash",
        "status"
      ],
      "properties": {
        "payload_surface": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "plugin_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        },
        "expected_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/payload_file"
          }
        },
        "actual_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/payload_file"
          }
        },
        "missing_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatched_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_leaks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "script_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "file_tree_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "payload_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256",
        "required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
          }
        },
        "source_path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "manifest",
            "skill",
            "agent",
            "hook",
            "runner",
            "install_guidance",
            "trust_metadata",
            "checksum",
            "version_metadata",
            "docs"
          ]
        },
        "transform": {
          "enum": [
            "none",
            "claude_guard_strip",
            "codex_overlay",
            "path_normalization",
            "manifest_rewrite"
          ],
          "default": "none"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "runner_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "product",
        "platform",
        "surface_path",
        "operation",
        "interpreter_resolution",
        "invocation",
        "runner_request",
        "runner_response",
        "status",
        "diagnostics"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "surface_path": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "preflight",
            "scaffold",
            "status",
            "autopilot-dry-run",
            "doctor",
            "update",
            "autoheal"
          ]
        },
        "interpreter_resolution": {
          "$ref": "#/$defs/interpreter_resolution"
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "stdin_mode",
            "stdout_mode",
            "stderr_mode",
            "shell_used"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "oneOf": [
                {
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "const": "-m"
                    },
                    {
                      "const": "speckit_pro_runner"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "pattern": "^-"
                    },
                    {
                      "const": "-m"
                    },
                    {
                      "const": "speckit_pro_runner"
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "maxItems": 0
                }
              ]
            },
            "stdin_mode": {
              "const": "single_json_request"
            },
            "stdout_mode": {
              "const": "single_json_response"
            },
            "stderr_mode": {
              "const": "diagnostics_only"
            },
            "shell_used": {
              "const": false
            }
          }
        },
        "runner_request": {
          "type": "object"
        },
        "runner_response": {
          "type": [
            "object",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "interpreter_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted_candidates",
        "resolved_executable",
        "invocation_argv_prefix",
        "version",
        "accepted",
        "minimum_version",
        "failure_code",
        "diagnostic"
      ],
      "properties": {
        "attempted_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolved_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_argv_prefix": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "minimum_version": {
          "const": "3.11"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "object"
        }
      }
    }
  }
}
