{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/speckit-pro/xplat-009/historical-allowlist-entry.schema.json",
  "title": "XPLAT-009 Historical Allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "entries"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "feature_id": { "const": "XPLAT-009" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "categories",
        "reason",
        "scope",
        "release_readiness_excluded"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reason": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "release_readiness_excluded": { "const": true }
      }
    }
  }
}
