{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero-Bash guard response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "exit_code", "data", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {
      "enum": ["ok", "expected_failure", "input_error", "missing_prerequisite", "subprocess_failure", "internal_failure"]
    },
    "exit_code": {"type": "integer"},
    "legacy_exit_code": {"type": ["integer", "null"]},
    "request_id": {"type": ["string", "null"]},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "artifacts",
        "schema_version",
        "contract_id",
        "status",
        "blocking_count",
        "classified_counts",
        "findings",
        "total_finding_count",
        "truncated_finding_count",
        "script_file_count",
        "scan_roots",
        "allowlist"
      ],
      "properties": {
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate_id", "operation", "gate_status", "promoted", "blocking", "comparison_ids"],
          "properties": {
            "gate_id": {"const": "active-path-guard"},
            "operation": {"const": "zero-bash-guard"},
            "gate_status": {"enum": ["pass", "fail"]},
            "promoted": {"type": "boolean"},
            "blocking": {"type": "boolean"},
            "comparison_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "contract_id": {"const": "plugin-bash-confinement"},
        "status": {"enum": ["pass", "fail"]},
        "blocking_count": {"type": "integer", "minimum": 0},
        "classified_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "total_finding_count": {"type": "integer", "minimum": 0},
        "truncated_finding_count": {"type": "integer", "minimum": 0},
        "script_file_count": {"type": "integer", "minimum": 0},
        "scan_roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "allowlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "entry_count", "release_readiness_excluded"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "entry_count": {"type": "integer", "minimum": 0},
            "release_readiness_excluded": {"type": "boolean"}
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "not": {"pattern": "(^/|^[A-Za-z]:|\\.\\.)"}
              },
              "kind": {"type": "string", "minLength": 1}
            }
          }
        },
        "schema_version": {"const": "2.0"}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "path", "line", "category", "pattern", "reason", "active_role", "classification", "remediation"],
      "properties": {
        "surface": {"enum": ["plugin_source", "claude_payload", "codex_payload", "repository"]},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "category": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "active_role": {"type": "string", "minLength": 1},
        "classification": {"enum": ["blocking_zero_bash", "historical_allowlist", "tool_declaration", "negative_policy"]},
        "remediation": {"type": "string", "minLength": 1}
      }
    }
  }
}
