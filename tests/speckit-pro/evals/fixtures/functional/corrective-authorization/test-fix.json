{
  "schema": "corrective-authorization-replay/v1",
  "description": "A test-only fix to a test file the increment itself edited runs without a re-plan and needs no operator event; product code, another increment's test, or a second fix for the same increment uses the run-wide budget and defers.",
  "steps": [
    {
      "id": "greenfield",
      "place_spec": "absent"
    },
    {
      "id": "spec-written",
      "place_spec": "spec.md"
    },
    {
      "id": "stage-plan",
      "stage": {
        "feature/plan.md": "test-fix/plan.md",
        "feature/tasks.md": "test-fix/tasks.md",
        "feature/.process/task-execution.json": "test-fix/task-execution.json",
        "tests/test_runner.py": "test-fix/tests/test_runner.py.txt",
        "tests/test_beta.py": "test-fix/tests/test_beta.py.txt",
        "tests/test_alpha_extra.py": "test-fix/tests/test_alpha_extra.py.txt"
      }
    },
    {
      "id": "baseline",
      "git": "baseline"
    },
    {
      "id": "start",
      "action": "start",
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "reserve-fix-a",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "fix-a",
        "kind": "corrective",
        "failure_invariant": "FR-001"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "fix-a-completed",
      "action": "complete",
      "inputs": {
        "dispatch_id": "fix-a",
        "outcome": "completed"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "reserve-fix-b",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "fix-b",
        "kind": "corrective",
        "failure_invariant": "FR-002"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "fix-b-completed",
      "action": "complete",
      "inputs": {
        "dispatch_id": "fix-b",
        "outcome": "completed"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "reserve-alpha-implement",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "alpha-implement",
        "kind": "implementation",
        "tdd_units": [
          "alpha"
        ]
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "alpha-goes-red",
      "write": {
        "src/alpha/core.py": "def cancel():\n    return None\n",
        "tests/test_runner.py": "import mock\n\ndef test_cancellation():\n    assert False\n"
      }
    },
    {
      "id": "alpha-implement-failed",
      "action": "complete",
      "inputs": {
        "dispatch_id": "alpha-implement",
        "outcome": "failed"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue",
        "ledger": {
          "dispatches.alpha-implement.changed_paths": [
            "src/alpha/core.py",
            "tests/test_runner.py"
          ]
        }
      }
    },
    {
      "id": "reserve-beta-implement",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "beta-implement",
        "kind": "implementation",
        "tdd_units": [
          "beta"
        ]
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "beta-edits-its-test",
      "write": {
        "tests/test_beta.py": "def test_beta():\n    assert 1\n"
      }
    },
    {
      "id": "beta-implement-completed",
      "action": "complete",
      "inputs": {
        "dispatch_id": "beta-implement",
        "outcome": "completed"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue"
      }
    },
    {
      "id": "product-code-refused",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "alpha-product",
        "kind": "corrective",
        "spec_file": "feature/spec.md",
        "failure_invariant": "FR-001",
        "test_fix": {
          "tdd_unit": "alpha",
          "paths": [
            "tests/test_runner.py",
            "src/alpha/core.py"
          ]
        }
      },
      "expect": {
        "exit_code": 1,
        "status": "expected_failure",
        "disposition": "defer",
        "reasons": [
          "failure_family_budget_exhausted"
        ],
        "data": {
          "test_fix_allowance": "run_wide",
          "test_fix_ineligible": "path_not_test_code"
        }
      }
    },
    {
      "id": "other-increments-test-refused",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "alpha-beta-test",
        "kind": "corrective",
        "spec_file": "feature/spec.md",
        "failure_invariant": "FR-001",
        "test_fix": {
          "tdd_unit": "alpha",
          "paths": [
            "tests/test_beta.py"
          ]
        }
      },
      "expect": {
        "exit_code": 1,
        "status": "expected_failure",
        "disposition": "defer",
        "data": {
          "test_fix_allowance": "run_wide",
          "test_fix_ineligible": "path_outside_increment_ownership"
        }
      }
    },
    {
      "id": "test-only-fix-admitted",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "alpha-test-fix",
        "kind": "corrective",
        "spec_file": "feature/spec.md",
        "failure_invariant": "FR-001",
        "test_fix": {
          "tdd_unit": "alpha",
          "paths": [
            "tests/test_runner.py"
          ]
        }
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue",
        "data": {
          "test_fix_allowance": "increment"
        },
        "ledger": {
          "corrective_cycles": 2,
          "test_fix_allowances.alpha.rounds": 1,
          "dispatches.alpha-test-fix.test_fix": "alpha"
        }
      }
    },
    {
      "id": "no-change-does-not-complete",
      "action": "complete",
      "inputs": {
        "dispatch_id": "alpha-test-fix",
        "outcome": "completed"
      },
      "expect": {
        "exit_code": 1,
        "status": "expected_failure",
        "disposition": "checkpoint_required",
        "reasons": [
          "test_fix_scope_unproven"
        ],
        "ledger": {
          "dispatches.alpha-test-fix.outcome": "reserved"
        }
      }
    },
    {
      "id": "fix-turns-green",
      "write": {
        "tests/test_runner.py": "def test_cancellation():\n    assert True\n"
      }
    },
    {
      "id": "test-fix-completed",
      "action": "complete",
      "inputs": {
        "dispatch_id": "alpha-test-fix",
        "outcome": "completed"
      },
      "expect": {
        "exit_code": 0,
        "status": "ok",
        "disposition": "continue",
        "ledger": {
          "dispatches.alpha-test-fix.outcome": "completed",
          "dispatches.alpha-test-fix.changed_paths": [
            "tests/test_runner.py"
          ]
        }
      }
    },
    {
      "id": "second-test-fix-refused",
      "action": "reserve",
      "inputs": {
        "dispatch_id": "alpha-test-fix-2",
        "kind": "corrective",
        "spec_file": "feature/spec.md",
        "failure_invariant": "FR-001",
        "test_fix": {
          "tdd_unit": "alpha",
          "paths": [
            "tests/test_runner.py"
          ]
        }
      },
      "expect": {
        "exit_code": 1,
        "status": "expected_failure",
        "disposition": "defer",
        "data": {
          "test_fix_allowance": "run_wide",
          "test_fix_ineligible": "test_fix_allowance_spent"
        },
        "ledger": {
          "test_fix_allowances.alpha.rounds": 1
        }
      }
    }
  ]
}
