{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/g56r-003/runtime/analysis-plan.schema.json",
  "title": "G56R-003 Frozen Calibration Analysis Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_plan_id",
    "analysis_plan_version",
    "analysis_plan_digest",
    "status",
    "calibration_partition_binding",
    "calibration_evidence_bindings",
    "freeze_provenance",
    "workload_manifest",
    "cache_policy",
    "quality_floors",
    "non_inferiority",
    "pareto_policy",
    "estimand_policy",
    "attrition_policy",
    "rerun_policy",
    "campaign_budget",
    "racing_policy",
    "futility_policy",
    "terminal_policy"
  ],
  "properties": {
    "schema_version": {"const": "analysis-plan.v1"},
    "analysis_plan_id": {"$ref": "#/$defs/digest"},
    "analysis_plan_version": {"type": "string", "minLength": 1},
    "analysis_plan_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "frozen"},
    "calibration_partition_binding": {"$ref": "#/$defs/calibrationPartitionBinding"},
    "calibration_evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    },
    "freeze_provenance": {"$ref": "#/$defs/freezeProvenance"},
    "workload_manifest": {"$ref": "#/$defs/workloadManifest"},
    "cache_policy": {"$ref": "#/$defs/cachePolicy"},
    "quality_floors": {"$ref": "#/$defs/qualityFloors"},
    "non_inferiority": {"$ref": "#/$defs/nonInferiority"},
    "pareto_policy": {"$ref": "#/$defs/paretoPolicy"},
    "estimand_policy": {"$ref": "#/$defs/estimandPolicy"},
    "attrition_policy": {"$ref": "#/$defs/attritionPolicy"},
    "rerun_policy": {"$ref": "#/$defs/rerunPolicy"},
    "campaign_budget": {"$ref": "#/$defs/budget"},
    "racing_policy": {"$ref": "#/$defs/disabledSequentialPolicy"},
    "futility_policy": {"$ref": "#/$defs/disabledSequentialPolicy"},
    "terminal_policy": {"$ref": "#/$defs/terminalPolicy"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "calibrationPartitionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_id",
        "partition_type",
        "partition_digest",
        "qualification_eligible"
      ],
      "properties": {
        "partition_id": {"type": "string", "minLength": 1},
        "partition_type": {"const": "calibration"},
        "partition_digest": {"$ref": "#/$defs/digest"},
        "qualification_eligible": {"const": false}
      }
    },
    "freezeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_at",
        "frozen_after_calibration",
        "cohort_outcome_observed",
        "pre_cohort_outcome_absence_digest",
        "independent_review_binding"
      ],
      "properties": {
        "frozen_at": {"type": "string", "format": "date-time"},
        "frozen_after_calibration": {"const": true},
        "cohort_outcome_observed": {"const": false},
        "pre_cohort_outcome_absence_digest": {"$ref": "#/$defs/digest"},
        "independent_review_binding": {"$ref": "#/$defs/binding"}
      }
    },
    "workloadManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_digest",
        "minimum_unique_tasks",
        "unknown_stratum_policy",
        "strata"
      ],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "minimum_unique_tasks": {"type": "integer", "minimum": 1},
        "unknown_stratum_policy": {"const": "inconclusive"},
        "strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/workloadStratum"}
        }
      }
    },
    "workloadStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "target_weight",
        "long_horizon",
        "p95_guardrails"
      ],
      "properties": {
        "stratum_id": {"type": "string", "minLength": 1},
        "target_weight": {"type": "number", "exclusiveMinimum": 0},
        "long_horizon": {"type": "boolean"},
        "p95_guardrails": {"$ref": "#/$defs/p95Guardrails"}
      }
    },
    "p95Guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_input_tokens_max",
        "cached_input_tokens_max",
        "output_tokens_max",
        "duration_ms_max"
      ],
      "properties": {
        "raw_input_tokens_max": {"type": "integer", "minimum": 1},
        "cached_input_tokens_max": {"type": "integer", "minimum": 0},
        "output_tokens_max": {"type": "integer", "minimum": 1},
        "duration_ms_max": {"type": "integer", "minimum": 1}
      }
    },
    "cachePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_digest",
        "pair_isolation",
        "order_leakage_prohibited",
        "cache_state"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "pair_isolation": {"const": true},
        "order_leakage_prohibited": {"const": true},
        "cache_state": {"const": "isolated_by_pair"}
      }
    },
    "qualityFloors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_order", "semantic", "reliability"],
      "properties": {
        "evaluation_order": {"const": 1},
        "semantic": {"$ref": "#/$defs/floor"},
        "reliability": {"$ref": "#/$defs/floor"}
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "minimum"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "minimum": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "nonInferiority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_order",
        "endpoints",
        "margins",
        "confidence_level",
        "alpha",
        "power",
        "sample_sizes",
        "sample_size_assumptions",
        "cluster_unit",
        "cluster_adjustment",
        "multiplicity_adjustment"
      ],
      "properties": {
        "evaluation_order": {"const": 2},
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["semantic_score", "reliability_score"]}
        },
        "margins": {"$ref": "#/$defs/nonInferiorityMargins"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "sample_sizes": {"$ref": "#/$defs/sampleSizes"},
        "sample_size_assumptions": {"$ref": "#/$defs/sampleSizeAssumptions"},
        "cluster_unit": {"enum": ["role", "fixture"]},
        "cluster_adjustment": {"type": "string", "minLength": 1},
        "multiplicity_adjustment": {"type": "string", "minLength": 1}
      }
    },
    "nonInferiorityMargins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_score", "reliability_score"],
      "properties": {
        "semantic_score": {"type": "number"},
        "reliability_score": {"type": "number"}
      }
    },
    "sampleSizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_role_minimum"],
      "properties": {
        "per_role_minimum": {"type": "integer", "minimum": 1}
      }
    },
    "sampleSizeAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variance_source_binding", "expected_missingness_rate"],
      "properties": {
        "variance_source_binding": {"$ref": "#/$defs/binding"},
        "expected_missingness_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "paretoPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_order",
        "dimensions",
        "directions",
        "weights_prohibited",
        "mixed_or_tied_result"
      ],
      "properties": {
        "evaluation_order": {"const": 3},
        "dimensions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "raw_input_tokens"},
            {"const": "cached_input_tokens"},
            {"const": "output_tokens"},
            {"const": "duration_ms"},
            {"const": "retries"},
            {"const": "compactions"},
            {"const": "acceptance"},
            {"const": "terminal_state"}
          ],
          "items": false
        },
        "directions": {"$ref": "#/$defs/paretoDirections"},
        "weights_prohibited": {"const": true},
        "mixed_or_tied_result": {"const": "inconclusive"}
      }
    },
    "paretoDirections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "duration_ms",
        "retries",
        "compactions",
        "acceptance",
        "terminal_state"
      ],
      "properties": {
        "raw_input_tokens": {"const": "lower"},
        "cached_input_tokens": {"const": "lower"},
        "output_tokens": {"const": "lower"},
        "duration_ms": {"const": "lower"},
        "retries": {"const": "lower"},
        "compactions": {"const": "lower"},
        "acceptance": {"const": "higher"},
        "terminal_state": {"const": "not_worse"}
      }
    },
    "estimandPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assigned_attempt",
        "candidate_terminal_acceptance_zero",
        "candidate_terminal_states",
        "complete_case_filtering"
      ],
      "properties": {
        "assigned_attempt": {"const": true},
        "candidate_terminal_acceptance_zero": {"const": true},
        "candidate_terminal_states": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "failed"},
            {"const": "timed_out"},
            {"const": "cancelled"},
            {"const": "budget_exhausted"},
            {"const": "abandoned"}
          ],
          "items": false
        },
        "complete_case_filtering": {"const": false}
      }
    },
    "attritionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cap",
        "unclassifiable_attrition",
        "unclassifiable_result",
        "complete_case_filtering"
      ],
      "properties": {
        "cap": {"type": "number", "minimum": 0, "maximum": 1},
        "unclassifiable_attrition": {"const": "evidence_boundary_failure"},
        "unclassifiable_result": {"const": "inconclusive"},
        "complete_case_filtering": {"const": false}
      }
    },
    "rerunPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_failure",
        "scope",
        "cap",
        "one_arm_rerun_prohibited"
      ],
      "properties": {
        "eligible_failure": {"const": "independently_preclassified_transient_harness_failure"},
        "scope": {"const": "complete_pair"},
        "cap": {"type": "integer", "minimum": 0},
        "one_arm_rerun_prohibited": {"const": true}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_wall_clock_seconds",
        "max_raw_input_tokens",
        "max_cached_input_tokens",
        "max_output_tokens",
        "max_candidates",
        "max_confirmation_entries"
      ],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_wall_clock_seconds": {"type": "integer", "minimum": 1},
        "max_raw_input_tokens": {"type": "integer", "minimum": 1},
        "max_cached_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_confirmation_entries": {"type": "integer", "minimum": 0}
      }
    },
    "disabledSequentialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "terminal_rule"],
      "properties": {
        "enabled": {"const": false},
        "terminal_rule": {"const": "disabled"}
      }
    },
    "terminalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incomplete_result", "uncertain_result", "no_forced_ranking"],
      "properties": {
        "incomplete_result": {"const": "inconclusive"},
        "uncertain_result": {"const": "inconclusive"},
        "no_forced_ranking": {"const": true}
      }
    }
  }
}
