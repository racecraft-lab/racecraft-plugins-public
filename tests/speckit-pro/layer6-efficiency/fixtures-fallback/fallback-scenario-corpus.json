            "effort": "high",
            "qualified": true
          }
        ],
        "budgets": {"max_probe_attempts": 4, "max_retries": 2, "max_candidate_routes": 4}
      },
      "snapshot": {
        "schema_version": "1.0.0",
        "available_models": ["model-probed", "model-unprobed"],
        "alias_bindings": {"alias-probed": "model-probed", "alias-unprobed": "model-unprobed"},
        "supported_efforts": {
          "model-probed": ["low", "medium", "high"],
          "model-unprobed": ["low", "medium", "high"]
