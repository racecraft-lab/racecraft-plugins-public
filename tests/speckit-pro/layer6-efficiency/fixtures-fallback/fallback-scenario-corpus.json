    {
      "case_id": "preferred-absent-fallback-selected",
      "purpose": "An environment that no longer offers the preferred route's pinned resolved model, but does offer the declared fallback's.",
      "proves": "The walk attempts the preferred route first, records it as rejected with a model_absent sub-reason, then selects the first compatible declared fallback and reports that fallback's tuple as the effective dispatch tuple.",
