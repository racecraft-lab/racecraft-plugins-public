      "policy": {
        "schema_version": "1.0.0",
        "agent": {"name": "fixture-required-executor", "role_class": "required_executor"},
        "preferred_route": {
          "route_id": "preferred-primary",
          "alias": "alias-primary",
          "resolved_model": "model-primary",
          "effort": "high",
          "qualified": true
        },
        "fallback_routes": [
          {
            "route_id": "fallback-secondary",
            "alias": "alias-secondary",
            "resolved_model": "model-secondary",
            "effort": "high",
            "qualified": true
          }
        ],
        "budgets": {"max_probe_attempts": 4, "max_retries": 2, "max_candidate_routes": 4}
      },
      "snapshot": {
        "schema_version": "1.0.0",
        "available_models": ["model-secondary"],
        "alias_bindings": {"alias-primary": "model-primary", "alias-secondary": "model-secondary"},
        "supported_efforts": {"model-secondary": ["low", "medium", "high"]},
        "probe_availability": {"model-secondary": true},
        "exact_invocation_probe": {"model-secondary": "success"},
        "platform_route_changes": [],
        "available_models_allowlist": ["model-primary", "model-secondary"]
      },
      "overrides": null,
      "expected_report": {
        "schema_version": "1.0.0",
        "agent": "fixture-required-executor",
        "outcome": "resolved",
        "attempted_routes": [
          {
            "route_id": "preferred-primary",
            "alias": "alias-primary",
            "resolved_model": "model-primary",
            "effort": "high",
            "disposition": "rejected"
          },
          {
            "route_id": "fallback-secondary",
            "alias": "alias-secondary",
            "resolved_model": "model-secondary",
            "effort": "high",
            "disposition": "selected"
          }
        ],
        "diagnostics": [
          {
            "code": "preferred_model_unavailable",
            "message": "Route preferred-primary pins a tuple the environment does not offer (model_absent).",
            "severity": "warning",
            "source": "route-fallback-simulator",
            "remediation": {
              "summary": "The route's pinned alias and resolved model no longer match the environment.",
              "actions": ["Re-probe the environment and confirm the pinned alias and resolved model."]
            },
            "details": {
              "alias": "alias-primary",
              "pinned_resolved_model": "model-primary",
              "route_id": "preferred-primary",
              "sub_reason": "model_absent"
            }
          }
        ],
        "budgets": {
          "declared": {"max_probe_attempts": 4, "max_retries": 2, "max_candidate_routes": 4},
          "actual": {"probe_attempts": 1, "retries": 0, "candidate_routes": 2}
        },
        "release_claim_eligible": true,
        "optional_helper": {"consulted": false, "no_helper_path_validated": true, "probe_attempts": 0},
        "effective_dispatch_tuple": {
          "agent": "fixture-required-executor",
          "alias": "alias-secondary",
          "resolved_model": "model-secondary",
          "effort": "high"
        }
      }
    },
