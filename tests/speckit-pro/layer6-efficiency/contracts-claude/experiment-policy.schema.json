{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/car-003/experiment-policy.schema.json",
  "title": "CAR-003 Experiment Policy",
  "description": "Logical mirror of the G56R-003 spec-scoped experiment-policy contract. Adds the FR-047 static scorer-family exclusion declaration, which the Claude side requires to be carried in the frozen policy so it costs nothing at replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_policy_id",
    "policy_digest",
    "partition",
    "candidate_freeze_binding",
    "corpus_binding",
    "assignment_policy",
    "terminal_policy",
    "rerun_policy",
    "scorer_family_exclusion",
    "budget",
    "execution_mode"
  ],
  "allOf": [
    {
      "description": "FR-037. A qualification-eligible policy MUST bind the frozen analysis plan and MUST NOT carry a calibration protocol binding.",
      "if": {"properties": {"partition": {"properties": {"qualification_eligible": {"const": true}}}}, "required": ["partition"]},
      "then": {"required": ["analysis_plan_binding"], "not": {"required": ["calibration_protocol_binding"]}}
    },
    {
      "description": "FR-037. A calibration policy MUST bind the calibration protocol and MUST NOT bind the analysis plan, which does not yet exist when calibration runs.",
      "if": {"properties": {"partition": {"properties": {"qualification_eligible": {"const": false}}}}, "required": ["partition"]},
      "then": {"required": ["calibration_protocol_binding"], "not": {"required": ["analysis_plan_binding"]}}
    }
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_policy_id": {"type": "string", "minLength": 1},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "partition": {"$ref": "#/$defs/partition"},
    "candidate_freeze_binding": {"$ref": "#/$defs/binding"},
    "corpus_binding": {"$ref": "#/$defs/binding"},
    "analysis_plan_binding": {"$ref": "#/$defs/binding"},
    "calibration_protocol_binding": {
      "$ref": "#/$defs/binding",
      "description": "FR-037. A calibration-partition policy binds this instead of analysis_plan_binding. The analysis plan freezes only AFTER calibration, so requiring a calibration policy to bind it is a circular dependency that makes the calibration pilot unrunnable. The calibration protocol carries no margins, sample sizes, or terminal thresholds; the frozen analysis plan later references it as its calibration binding."
    },
    "assignment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_before_execution", "order_rule", "cache_isolation"],
      "properties": {
        "pair_before_execution": {"const": true},
        "order_rule": {"enum": ["balanced", "seeded_random"]},
        "cache_isolation": {
          "description": "US2 acceptance scenario 5: one arm may never warm another arm's cache.",
          "const": "per_arm_ephemeral_root"
        }
      }
    },
    "terminal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_failures_remain_in_estimand", "candidate_failure_acceptance"],
      "properties": {
        "candidate_failures_remain_in_estimand": {"const": true},
        "candidate_failure_acceptance": {"const": 0}
      }
    },
    "rerun_policy": {
      "description": "FR-021: the cap counts reruns rather than attempts, per comparison pair. Transient classification is made from arm-blind evidence before either arm's outcome is read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_failure", "scope", "cap", "classification_timing"],
      "properties": {
        "eligible_failure": {"const": "independently_preclassified_transient_harness_failure"},
        "scope": {"const": "complete_pair"},
        "cap": {"type": "integer", "minimum": 0},
        "classification_timing": {"const": "arm_blind_before_outcome_read"}
      }
    },
    "scorer_family_exclusion": {
      "description": "FR-047: static declaration barring a scorer or adjudicator from any candidate's own model family. Declared here so it carries no replay cost.",
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "paraphrase_normalization", "presentation_order_seed", "entries"],
      "properties": {
        "static": {"const": true},
        "paraphrase_normalization": {"const": "prohibited"},
        "presentation_order_seed": {"type": "string", "minLength": 1},
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_route_id", "excluded_families"],
            "properties": {
              "candidate_route_id": {"type": "string", "minLength": 1},
              "excluded_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "budget": {
      "description": "FR-038: MUST equal the frozen analysis-plan budget for qualification-eligible partitions and MAY be tighter only for calibration. Any inequality fails closed with failure_plane=partition.",
      "$ref": "#/$defs/budget"
    },
    "execution_mode": {"enum": ["deterministic_replay", "explicit_local_live"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_id", "partition_type", "qualification_eligible"],
      "properties": {
        "partition_id": {"type": "string", "minLength": 1},
        "partition_type": {"enum": ["calibration", "screening", "selection", "cohort_lock", "integrated_confirmation"]},
        "qualification_eligible": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_duration_seconds",
        "max_input_tokens",
        "max_cache_write_tokens_by_ttl_class",
        "max_cache_read_tokens",
        "max_output_tokens",
        "max_candidates",
        "max_confirmation_entries"
      ],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_cache_write_tokens_by_ttl_class": {
          "description": "FR-022: separate cache-write ceilings by TTL class. Diagnostic-only, never a Pareto dimension. The key space is closed to the two cache-creation classes the frozen CAR-002 telemetry profile already records, and matches the additive cache diagnostic exactly so a ceiling can never be keyed differently from its measurement.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["ephemeral_5m", "ephemeral_1h"]},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "max_cache_read_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_confirmation_entries": {"type": "integer", "minimum": 0}
      }
    }
  }
}
