{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/g56r-005/route-policy.schema.json",
  "title": "G56R-005 Route Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "source_roster_id",
    "agent",
    "preferred_route",
    "fallback_routes",
    "strict_override",
    "helper_state",
    "fake_home",
    "budgets"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "source_roster_id": {"$ref": "#/$defs/digest"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role_classification", "non_route_treatment_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role_classification": {"enum": ["required_core", "optional_helper"]},
        "non_route_treatment_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "preferred_route": {"$ref": "#/$defs/routeCandidate"},
    "fallback_routes": {"type": "array", "items": {"$ref": "#/$defs/routeCandidate"}},
    "strict_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["absent", "compatible", "incompatible"]},
        "route_id": {"type": "string", "minLength": 1}
      }
    },
    "service_reroute": {"$ref": "#/$defs/serviceReroute"},
    "helper_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "no_helper_continuation_qualified", "helper_route_attempts"],
      "properties": {
        "available": {"type": "boolean"},
        "no_helper_continuation_qualified": {"type": "boolean"},
        "helper_route_attempts": {"type": "integer", "minimum": 0}
      }
    },
    "fake_home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_state_id", "temporary_root_required"],
      "properties": {
        "seed_state_id": {"$ref": "#/$defs/digest"},
        "temporary_root_required": {"const": true}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "max_elapsed_units", "max_fanout", "max_context_units", "cancellation_point", "max_escalations"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0},
        "max_elapsed_units": {"type": "integer", "minimum": 0},
        "max_fanout": {"type": "integer", "minimum": 1},
        "max_context_units": {"type": "integer", "minimum": 0},
        "cancellation_point": {"enum": ["none", "before_route", "after_mutation"]},
        "max_escalations": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded"],
      "properties": {
        "attempted": {"type": "boolean"},
        "succeeded": {"type": "boolean"}
      }
    },
    "routeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "model", "effort", "model_present", "effort_supported", "capability_discovery_available", "availability_probe", "treatment_probe", "non_route_treatment_digest", "declaration_source"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "model_present": {"type": "boolean"},
        "effort_supported": {"type": "boolean"},
        "capability_discovery_available": {"type": "boolean"},
        "availability_probe": {"$ref": "#/$defs/probe"},
        "treatment_probe": {"$ref": "#/$defs/probe"},
        "non_route_treatment_digest": {"$ref": "#/$defs/digest"},
        "declaration_source": {
          "enum": [
            "local",
            "inherited_model",
            "inherited_effort",
            "generic_substitution",
            "unqualified_adjacent"
          ]
        }
      }
    },
    "serviceReroute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "observed_target_route", "approval", "approval_evidence", "scoring_effect", "non_route_treatment_digest"],
      "properties": {
        "origin": {"const": "service"},
        "observed_target_route": {"type": "string", "minLength": 1},
        "approval": {"enum": ["approved", "unapproved"]},
        "approval_evidence": {"type": "string", "minLength": 1},
        "scoring_effect": {"enum": ["eligible", "ineligible"]},
        "non_route_treatment_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
