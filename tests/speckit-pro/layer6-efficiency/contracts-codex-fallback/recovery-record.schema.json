{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft.dev/schemas/g56r-005/recovery-record.schema.json",
  "title": "G56R-005 Recovery Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pre_state_id",
    "final_state_id",
    "staged_actions",
    "applied_actions",
    "rolled_back_actions",
    "cleanup_actions",
    "cleanup_errors",
    "rollback_outcome",
    "writes_state",
    "manual_remediation",
    "terminal_outcome"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pre_state_id": {"$ref": "#/$defs/digest"},
    "final_state_id": {"$ref": "#/$defs/digest"},
    "staged_actions": {"$ref": "#/$defs/actions"},
    "applied_actions": {"$ref": "#/$defs/actions"},
    "rolled_back_actions": {"$ref": "#/$defs/actions"},
    "cleanup_actions": {"$ref": "#/$defs/actions"},
    "cleanup_errors": {"type": "array", "items": {"type": "string"}},
    "rollback_outcome": {"enum": ["not_required", "restored", "failed"]},
    "writes_state": {"type": "boolean"},
    "manual_remediation": {"type": "array", "items": {"type": "string"}},
    "terminal_outcome": {
      "enum": [
        "qualified_route",
        "strict_override_rejected",
        "bounded_retry_exhausted",
        "time_budget_exhausted",
        "fanout_budget_rejected",
        "context_budget_rejected",
        "cancellation_observed",
        "escalation_rejected",
        "no_safe_route"
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "path", "role_classification"],
        "properties": {
          "action": {"enum": ["stage", "write", "restore", "remove", "cleanup"]},
          "path": {"type": "string", "pattern": "^\\.codex/agents/[^/]+\\.toml$"},
          "role_classification": {"enum": ["required_core", "optional_helper"]}
        }
      }
    }
  }
}
