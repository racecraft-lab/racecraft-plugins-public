      "multiplicity_declaration": {
        "conjunctive_family": {
          "adjustment": "none_required",
          "rationale": "The absolute floors and the non-inferiority stage are conjunctive: all must pass, so the stage controls error at alpha with no adjustment and no alpha relaxation, paying the cost in power."
        },
        "pareto_disjunctive_family": {
          "adjustment": "holm_bonferroni_over_the_eight_dimension_disjunction",
          "rationale": "'Better on at least one dimension' is disjunctive and inflates the spurious-win rate with each added dimension unless controlled. The conjunctive 'no worse everywhere' half needs no adjustment, so leaving the whole stage unadjusted would under-protect."
        },
        "across_ladder_family": {
          "adjustment": "benjamini_hochberg_false_discovery_control_across_candidate_role_stratum_ladders",
          "rationale": "Many ladders across candidates, roles, and strata form a family of their own, declared independently of the within-ladder rule."
        },
        "cluster_adjustment_is_precondition": true
      }
    },
