  "comparison_digest": "sha256:8bd3e12167629be1cd77221a1a5554aaf87865452c091bb5fdd0e8b07044f8bc",
  "comparison_id": "car-004-control-comparison",
  "confidence_method": {
    "alpha": 0.05,
    "cluster_adjustment": "cluster_robust_sandwich_variance_by_role",
    "cluster_unit": "role",
    "confidence_level": 0.95,
    "method": "one_sided_lower_confidence_bound",
    "replay_point_estimate_stand_in": true
  },
  "dominance_rule": {
    "dimension_projection": {
      "duration_ms": "duration"
    },
    "dimensions": [
      "input_tokens",
      "cached_input_tokens",
      "output_tokens",
      "duration",
      "retries",
      "compactions",
      "acceptance",
      "terminal_state"
    ],
    "evaluation_order": [
      "eligibility_floors",
      "pareto",
      "materiality_margin"
    ],
    "margin_denominator": "comparator_value",
    "margin_map": {
      "acceptance": {
        "class": "no_worse_only",
        "direction": "higher_is_better",
        "reason": "acceptance is higher-is-better quality rather than cost, and a control that is cheaper because it gave up must never read as materially dominant, so it can only defeat dominance",
        "unit": "ratio"
      },
      "cached_input_tokens": {
        "class": "margin_eligible",
        "direction": "lower_is_better",
        "relative_margin": 0.1,
        "unit": "tokens"
      },
      "compactions": {
        "class": "no_worse_only",
        "direction": "lower_is_better",
        "reason": "a compaction count is an integer reliability count on the same footing as retries, so it can defeat material dominance by being worse but can never supply it",
        "unit": "count"
      },
      "duration": {
        "class": "margin_eligible",
        "direction": "lower_is_better",
        "relative_margin": 0.1,
        "unit": "milliseconds"
      },
      "input_tokens": {
        "class": "margin_eligible",
        "direction": "lower_is_better",
        "relative_margin": 0.1,
        "unit": "tokens"
      },
      "output_tokens": {
        "class": "margin_eligible",
        "direction": "lower_is_better",
        "relative_margin": 0.1,
        "unit": "tokens"
      },
      "retries": {
        "class": "no_worse_only",
        "direction": "lower_is_better",
        "reason": "a retry count is an integer reliability count, not a ratio-scale cost, so a relative margin over it would read a single avoided retry as a large proportional gain; being worse still defeats dominance",
        "unit": "count"
      },
      "terminal_state": {
        "class": "no_worse_only",
        "direction": "equal_only",
        "reason": "terminal state is categorical and unordered here — the aggregation-time severity rank is never read by this document — so any difference is a difference in kind and makes the comparison inconclusive",
        "unit": "categorical"
      }
    },
    "rule": "environment_independent_pareto",
    "weights_prohibited": true,
    "zero_denominator_result": "margin_not_computable"
  },
  "eligibility_floors": {
    "all_gates_must_pass": true,
    "availability_gate_required": true,
    "claim_class_when_floor_unmet": "no_comparative_claim",
