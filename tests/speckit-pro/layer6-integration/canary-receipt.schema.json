{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canary receipt v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "commit", "host", "host_version", "plugin_version", "fixture_tag", "trigger", "dirty_tree", "release_status_allowed", "install_probe", "variants"],
  "properties": {
    "schema_version": {"const": "canary-receipt/v2"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host": {"enum": ["claude-code", "codex"]},
    "host_version": {"$ref": "#/$defs/text"}, "plugin_version": {"$ref": "#/$defs/text"},
    "fixture_tag": {"$ref": "#/$defs/text"}, "trigger": {"enum": ["local", "scheduled", "on_demand"]},
    "dirty_tree": {"type": "boolean"}, "release_status_allowed": {"type": "boolean"},
    "install_probe": {"type": "object"},
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}}
  },
  "allOf": [{"if": {"properties": {"host": {"const": "codex"}}},
    "then": {"properties": {"install_probe": {"$ref": "#/$defs/codex_probe"},
      "variants": {"items": {"properties": {"stages": {"properties": {
        "scaffold": {"$ref": "#/$defs/codex_stage"}, "plan": {"$ref": "#/$defs/codex_stage"},
        "plan_review": {"$ref": "#/$defs/codex_stage"}, "implement": {"$ref": "#/$defs/codex_stage"}
      }}}}}}},
    "else": {"properties": {"install_probe": {"$ref": "#/$defs/claude_probe"}}}}],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "count": {"type": "integer", "minimum": 0},
    "probe_result": {"enum": ["passed", "failed", "not_run"]},
    "codex_probe": {
      "type": "object", "additionalProperties": false, "required": ["headless_install", "skill_expansion", "evidence"],
      "properties": {"headless_install": {"$ref": "#/$defs/probe_result"}, "skill_expansion": {"$ref": "#/$defs/probe_result"}, "evidence": {"$ref": "#/$defs/text"}}
    },
    "claude_probe": {
      "type": "object", "additionalProperties": false, "required": ["loaded_plugins", "evidence"],
      "properties": {"loaded_plugins": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "evidence": {"$ref": "#/$defs/text"}}
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_seconds", "tokens"],
      "properties": {"wall_seconds": {"type": "number", "minimum": 0}, "tokens": {"$ref": "#/$defs/count"},
        "codex_tokens": {"$ref": "#/$defs/codex_tokens"}}
    },
    "codex_tokens": {
      "description": "Stage-scoped root usage and one token count per descendant rollout, including nested children. Each count excludes inherited history and usage outside this stage; repeated cumulative snapshots are not separate counts.",
      "type": "object", "additionalProperties": false,
      "required": ["root_tokens", "child_rollout_tokens"],
      "properties": {"root_tokens": {"$ref": "#/$defs/count"},
        "child_rollout_tokens": {"type": "array", "items": {"$ref": "#/$defs/count"}}}
    },
    "codex_stage": {"allOf": [{"$ref": "#/$defs/stage"}, {"required": ["codex_tokens"]}]},
    "plan_target": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_seconds_limit", "tokens_limit", "target_met"],
      "properties": {"wall_seconds_limit": {"const": 1800}, "tokens_limit": {"const": 15000000},
        "target_met": {"type": "boolean"}}
    },
    "plan_quality": {
      "description": "ADR 0023 artifact checks at the end of planning; an open gap, finding or clarification passes only when it is in blocked_for_uat_listed, and the list cannot exceed the variant's blocked_for_uat count. Open items and blocked_for_uat_listed entries use the same item id: a repository-relative artifact location path:Lnn (for example spec.md:L24) or an analyze finding id (for example F001), never a blocked task or gate id. Untraced requirements have no exemption. requirements_total is at least 1; a variant that never reached Specify fails rather than reporting an empty plan as passing.",
      "type": "object", "additionalProperties": false,
      "required": ["phases_run", "clarify_sessions", "requirements_total", "untraced_requirements", "open_gaps", "open_findings", "open_clarifications", "blocked_for_uat_listed", "decisions"],
      "properties": {
        "phases_run": {"type": "array", "uniqueItems": true, "items": {"enum": ["specify", "clarify", "plan", "checklist", "tasks", "analyze"]}},
        "clarify_sessions": {"$ref": "#/$defs/count"}, "requirements_total": {"type": "integer", "minimum": 1},
        "untraced_requirements": {"$ref": "#/$defs/ids"}, "open_gaps": {"$ref": "#/$defs/ids"},
        "open_findings": {"$ref": "#/$defs/ids"}, "open_clarifications": {"$ref": "#/$defs/ids"},
        "blocked_for_uat_listed": {"$ref": "#/$defs/ids"},
        "decisions": {"type": "object", "additionalProperties": false, "required": ["total", "low_confidence", "consensus_rounds_by_kind"],
          "properties": {"total": {"$ref": "#/$defs/count"}, "low_confidence": {"$ref": "#/$defs/count"},
            "consensus_rounds_by_kind": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}}}
      }
    },
    "ids": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "verdict", "failed_assertions", "umask", "task_list_calls", "questions_after_scaffold", "unregistered_stops", "planning_end", "implement_end", "uat_runbook", "decisions_by_kind", "retry_attempts", "blocked_for_uat", "plan_quality", "stages"],
      "properties": {
        "name": {"enum": ["base", "oversized_plan", "security_interrupt", "missing_question_guard", "security_block"]},
        "verdict": {"enum": ["pass", "fail"]},
        "failed_assertions": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
        "umask": {"type": "string"}, "task_list_calls": {"$ref": "#/$defs/count"},
        "questions_after_scaffold": {"$ref": "#/$defs/count"}, "unregistered_stops": {"$ref": "#/$defs/count"},
        "planning_end": {"type": "string"}, "implement_end": {"type": "string"}, "uat_runbook": {"type": "string"},
        "decisions_by_kind": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}},
        "retry_attempts": {"$ref": "#/$defs/count"}, "blocked_for_uat": {"$ref": "#/$defs/count"},
        "split_recommendation_recorded": {"type": "boolean"}, "full_plan_built": {"type": "boolean"}, "stops": {"$ref": "#/$defs/count"},
        "question_guard": {
          "type": "object", "additionalProperties": false,
          "required": ["gap_recorded", "guarded_work_completed", "guarded_work_passed"],
          "properties": {"gap_recorded": {"type": "boolean"}, "guarded_work_completed": {"$ref": "#/$defs/count"},
            "guarded_work_passed": {"$ref": "#/$defs/count"}}
        },
        "security_interrupt": {
          "type": "object", "additionalProperties": false,
          "required": ["runner_permit_verified", "simulated_responder_answered", "pause_classification"],
          "properties": {"runner_permit_verified": {"type": "boolean"}, "simulated_responder_answered": {"type": "boolean"},
            "pause_classification": {"enum": ["authorized", "unregistered", "not_observed"]}}
        },
        "security_block": {
          "type": "object", "additionalProperties": false,
          "required": ["affected_work", "affected_work_blocked_for_uat", "independent_work", "independent_work_completed"],
          "properties": {"affected_work": {"$ref": "#/$defs/count"}, "affected_work_blocked_for_uat": {"$ref": "#/$defs/count"},
            "independent_work": {"$ref": "#/$defs/count"}, "independent_work_completed": {"$ref": "#/$defs/count"}}
        },
        "plan_target": {"$ref": "#/$defs/plan_target"},
        "plan_quality": {"$ref": "#/$defs/plan_quality"},
        "stages": {
          "type": "object", "additionalProperties": false, "required": ["scaffold", "plan", "plan_review", "implement"],
          "properties": {"scaffold": {"$ref": "#/$defs/stage"}, "plan": {"$ref": "#/$defs/stage"}, "plan_review": {"$ref": "#/$defs/stage"}, "implement": {"$ref": "#/$defs/stage"}}
        }
      },
      "allOf": [{"if": {"properties": {"name": {"const": "base"}}}, "then": {"required": ["plan_target"]}},
        {"if": {"properties": {"name": {"const": "oversized_plan"}}},
        "then": {"required": ["split_recommendation_recorded", "full_plan_built", "stops"]}},
        {"if": {"properties": {"name": {"const": "security_interrupt"}}}, "then": {"required": ["security_interrupt"]}},
        {"if": {"properties": {"name": {"const": "security_block"}}}, "then": {"required": ["security_block"]}}]
    }
  }
}
