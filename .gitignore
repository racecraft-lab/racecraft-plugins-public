.DS_Store
*.log
.env
__pycache__/
*.pyc

# SpecKit generated cache artifacts
.specify/presets/.cache/
.specify/extensions/.cache/
.specify/workflows/.cache/
.specify/feature.json
/.worktrees

# Docs site local install/cache/build artifacts
docs-site/node_modules/
docs-site/.astro/
docs-site/dist/

# Layer 7 live captures are transient; commit reduced parser-fixture.jsonl only.
tests/speckit-pro/layer7-integration/**/transcript.jsonl

# Transient per-agent scratch memory (subagent learnings; not a deliverable)
.claude/agent-memory/
.claude/agent-memory-local/

# Feedback-sweep transport byproducts: written and removed by the sweep, never committed
specs/*/.process/feedback-sweep/

# PR packets are local process exhaust; no spec in this repo tracks one. Tracked
# here rather than per-clone so the spec-index generator cannot bake a backlink
# to one into a committed SPEC-MOC.md.
specs/*/.process/pr-packets/

# Browser-automation scratch output (UAT screenshots, traces)
.playwright-mcp/
